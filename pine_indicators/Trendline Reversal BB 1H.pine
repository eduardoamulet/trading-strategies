//@version=6
// =============================================================
// INDICATOR: Trendline Reversal con Bollinger Bands
//
// CONSTRUCCIÓN INCREMENTAL — UNA REGLA A LA VEZ
// ─────────────────────────────────────────────
// ✅ Regla 1: Detección de tendencia bajista previa
//    - 2 pivot highs decrecientes dentro de `recentBars` velas
//    - Drop entre pivots ≥ minDropPct (filtro B contra micro-decrecientes)
//    - close < BB basis al menos 1 vez entre pivots (filtro A: downtrend real)
//    - Línea de tendencia trazada conectando ambos pivots
//
// ✅ Regla 2: Ruptura de la línea de tendencia
//    - Cumple cuando close > trendline (validado en cierre, no mecha)
//    - Modo "sticky": ☑ se mantiene mientras close siga arriba de la línea
//    - Marcador visual one-shot (▲ verde) en la vela del cruce
//
// ✅ Regla 3: Confirmación con Bollinger Bands (1H)
//    - close > BB basis (precio arriba de SMA20)
//    - Vela alcista (close > open)
//    - Cuerpo significativo (≥ X × ATR(14)) — toggle opcional
//
// ⏳ Pendientes (próximas iteraciones):
//    4. Confirmación en TF inferior (15m si chart=1H, etc.)
//
// Funciona con CUALQUIER ticker y CUALQUIER timeframe.
// La etiqueta de la regla muestra dinámicamente la TF actual.
// =============================================================

indicator("Trendline Reversal — Construcción", shorttitle="TR-Build",
     overlay=true,
     max_lines_count=50,
     max_labels_count=500)

// ============================================================
// INPUTS
// ============================================================
grpBB    = "Bollinger Bands (contexto visual)"
bbLen    = input.int(20,  "Periodo BB", group=grpBB, minval=2)
bbMult   = input.float(2.0, "Desviación BB", group=grpBB, minval=0.1, step=0.1)

grpRule1   = "Regla 1 — Tendencia bajista"
pivotLen   = input.int(5, "Sensibilidad de pivots (left/right)", group=grpRule1, minval=2,
     tooltip="Velas a cada lado que deben ser menores que el pivot. Mayor = más estricto, menos pivots.")
recentBars = input.int(60, "Máx velas desde el pivot más antiguo", group=grpRule1, minval=5,
     tooltip="El pivot MÁS VIEJO debe estar dentro de este rango (en barras de la TF actual).")
minDropPct = input.float(1.0, "Drop mínimo entre pivots (%)", group=grpRule1, minval=0.0, step=0.5,
     tooltip="El pivot viejo debe ser ≥ X% más alto que el nuevo. Filtra micro-decrecientes en uptrends. (Filtro B)")
requireBelowBasis = input.bool(true, "Requerir close < BB basis entre pivots", group=grpRule1,
     tooltip="Valida un downtrend REAL: el precio tuvo que cerrar debajo de SMA20 al menos una vez entre los 2 pivots. (Filtro A)")

grpRule3      = "Regla 3 — Confirmación BB"
useBodyFilter = input.bool(true, "Filtro de cuerpo de vela", group=grpRule3,
     tooltip="Si está ON, la vela de breakout debe tener cuerpo |close-open| ≥ bodyAtrMult × ATR(14). Filtra rupturas con velas pequeñas/dudosas.")
bodyAtrMult   = input.float(0.5, "Body mínimo / ATR(14)", group=grpRule3, minval=0.1, step=0.1,
     tooltip="Múltiplo de ATR(14) que el cuerpo de la vela debe alcanzar. Solo aplica si el filtro está ON. Mayor = más estricto, menos señales.")

grpViz           = "Visualización"
showLine         = input.bool(true,  "Dibujar línea de tendencia", group=grpViz)
showPiv          = input.bool(true,  "Mostrar marcadores de pivots", group=grpViz)
showTable        = input.bool(true,  "Mostrar tabla de reglas", group=grpViz)
showBBLabels     = input.bool(true,  "Mostrar etiquetas BB en escala de precios", group=grpViz,
     tooltip="Si lo desactivas, los textos 'TR-Build:BB upper', 'BB basis', 'BB lower' dejan de aparecer en la escala de precios derecha del chart. Las bandas siguen visibles, solo se ocultan las etiquetas.")
showHoverTooltip = input.bool(false, "Tooltips por vela (últimas 500)", group=grpViz,
     tooltip="Agrega un puntito gris debajo de cada vela. Pasa el mouse sobre el puntito para ver el estado de las reglas EN ESA VELA específica.\n\nLimitado a las últimas 500 velas (límite del API Pine de TradingView).\n\nNota UX: tienes que pasar el mouse sobre el puntito gris debajo de la vela, no sobre el cuerpo de la vela en sí — Pine no permite hover-on-candle directo.")

// ============================================================
// TIMEFRAME HELPER — Convierte timeframe.period a string humano
// "60" → "1H", "15" → "15m", "240" → "4H", "D" → "1D", etc.
// ============================================================
f_tf_human(string tf) =>
    n = str.tonumber(tf)
    na(n) ? tf : (n < 60 ? str.tostring(int(n)) + "m" : n == 60 ? "1H" : n < 1440 ? str.tostring(int(n / 60)) + "H" : str.tostring(int(n / 1440)) + "D")

tfHuman = f_tf_human(timeframe.period)

// ============================================================
// BOLLINGER BANDS (contexto visual, todavía sin usar como filtro)
// ============================================================
basis = ta.sma(close, bbLen)
dev   = bbMult * ta.stdev(close, bbLen)
upper = basis + dev
lower = basis - dev

// Toggle: cuando showBBLabels = false, ocultamos las etiquetas en la escala
// de precios (display.price_scale) pero mantenemos las líneas visibles en el
// chart, status line y data window.
bbDisplay = showBBLabels ? display.all : display.pane + display.status_line + display.data_window

plot(basis, "BB basis", color=color.orange, linewidth=2, display=bbDisplay)
p1 = plot(upper, "BB upper", color=color.new(color.gray, 50), display=bbDisplay)
p2 = plot(lower, "BB lower", color=color.new(color.gray, 50), display=bbDisplay)
fill(p1, p2, color=color.new(color.gray, 92))

// ============================================================
// REGLA 1 — Detección de tendencia bajista previa
// (evalúa en la TF actual del chart)
// ─────────────────────────────────────────────
// Sub-condiciones requeridas:
//   (1) 2 pivot highs decrecientes
//   (2) Fresh: pivot viejo dentro de `recentBars` velas
//   (3) Filtro B: drop entre pivots ≥ `minDropPct` %
//   (4) Filtro A: close < BB basis al menos 1 vez entre los 2 pivots
// ============================================================
ph = ta.pivothigh(high, pivotLen, pivotLen)

var float ph1   = na
var int   ph1x  = na
var float ph2   = na
var int   ph2x  = na

// Filtro A — track si close cerró por debajo del basis entre los 2 pivots.
// Solo se re-evalúa cuando llega un pivot NUEVO (no cada bar) — eficiente.
var bool wasBelowBasisLastPair = false

if not na(ph)
    ph2  := ph1
    ph2x := ph1x
    ph1  := ph
    ph1x := bar_index - pivotLen

    // Escaneo Filtro A: ¿hubo close < basis entre ph2x y ph1x?
    if not na(ph2)
        wasBelowBasisLastPair := false
        startOff = bar_index - ph1x   // offset del pivot nuevo (más reciente)
        endOff   = bar_index - ph2x   // offset del pivot viejo (más antiguo)
        for i = startOff to endOff
            if close[i] < basis[i]
                wasBelowBasisLastPair := true
                break

hasTwoPivots      = not na(ph1) and not na(ph2)
isDecreasing      = hasTwoPivots and ph1 < ph2
isFresh           = hasTwoPivots and (bar_index - ph2x) <= recentBars
pivotDropPct      = hasTwoPivots ? (ph2 - ph1) / ph2 * 100 : 0.0
isSignificantDrop = hasTwoPivots and pivotDropPct >= minDropPct          // Filtro B
realDowntrend     = (not requireBelowBasis) or wasBelowBasisLastPair     // Filtro A

rule1 = isDecreasing and isFresh and isSignificantDrop and realDowntrend

// ============================================================
// REGLA 2 — Ruptura de la línea de tendencia
// ─────────────────────────────────────────────
// SNAPSHOT del último trendline válido. Cada bar que rule1 esté activa,
// capturamos los parámetros del trendline (ph1, ph2, sus posiciones).
// Cuando rule1 deja de estar activa (por ejemplo: aparece un pivot
// ascendente que rompe el patrón decreciente), el snapshot PERSISTE
// hasta que expira tras `recentBars` velas sin actualización.
//
// Esto resuelve el caso del "reversal mayor": en un rally violento, los
// nuevos pivots ascendentes invalidan rule1 ANTES de que el close cruce
// la línea original. Sin snapshot, rule2 nunca puede dispararse porque
// trendlineNow se vuelve na. Con snapshot, la última línea bajista
// válida se mantiene "viva" durante el periodo de freshness para
// capturar exactamente ese cruce.
//
// Modo "sticky": rule2 se mantiene ☑ mientras (snapshot vigente) AND
// (close > trendline). Vuelve a ☐ cuando el snapshot expira o el precio
// retrocede debajo de la línea.
// ============================================================

// Snapshot del último trendline válido
var float snapP2  = na
var int   snapP2x = na
var float snapP1  = na
var int   snapP1x = na
var int   snapBornBar = na

// Capturar/actualizar snapshot cada bar que rule1 esté activa
if rule1
    snapP2      := ph2
    snapP2x     := ph2x
    snapP1      := ph1
    snapP1x     := ph1x
    snapBornBar := bar_index

// Snapshot válido si fue capturado/refrescado dentro de recentBars velas
snapAge   = na(snapBornBar) ? 999999 : bar_index - snapBornBar
snapValid = not na(snapP1) and not na(snapP2) and snapAge <= recentBars

// Trendline value extrapolado al bar actual usando el snapshot
slope        = snapValid ? (snapP1 - snapP2) / float(snapP1x - snapP2x) : na
trendlineNow = snapValid ? snapP2 + slope * (bar_index - snapP2x) : na

// Rule 2: close cierra arriba del último trendline válido (snapshot)
rule2 = snapValid and not na(trendlineNow) and close > trendlineNow

// Evento de ruptura: transición de false → true (one-shot marker visual)
breakoutEvent = rule2 and not rule2[1]

// ============================================================
// REGLA 3 — Confirmación con Bollinger Bands (TF actual)
// ─────────────────────────────────────────────
// Sub-condiciones requeridas (TODAS deben cumplirse):
//   (3a) close > basis      — precio arriba de la SMA20
//   (3b) close > open       — vela alcista
//   (3c) body filter (opc.) — |close-open| ≥ bodyAtrMult × ATR(14)
//
// Esta regla es el filtro que mata los falsos breakouts dentro del
// downtrend (donde close < basis típicamente). En el reversal real,
// price sale arriba del basis y la vela suele tener cuerpo significativo.
// ============================================================
atr14         = ta.atr(14)
candleBody    = math.abs(close - open)
aboveBasis    = close > basis                                              // 3a
bullishCandle = close > open                                               // 3b
bodyOk        = (not useBodyFilter) or (candleBody >= bodyAtrMult * atr14) // 3c

rule3 = aboveBasis and bullishCandle and bodyOk

// ============================================================
// VISUALIZACIÓN
// ============================================================
// Línea de tendencia bajista — refleja el snapshot del último trendline válido.
// Se redibuja cuando aparece un pivot nuevo Y rule1 está activa (snapshot fresco).
// La línea PERSISTE incluso cuando rule1 se invalida, hasta que el snapshot expire.
var line trendDown = na
if showLine and not na(ph) and rule1
    line.delete(trendDown)
    trendDown := line.new(ph2x, ph2, ph1x, ph1, color=color.new(color.red, 30),
         width=1, style=line.style_dashed, extend=extend.right)

// Borrar la línea cuando el snapshot expire (ya no está vigente)
if showLine and not snapValid and not na(trendDown)
    line.delete(trendDown)
    trendDown := na

// Plot continuo del snapshot trendline — muestra el VALOR REAL de la línea
// en cada bar mientras el snapshot esté vigente. Complemento al line.new que
// puede proyectarse off-screen con extend.right en bajistas pronunciadas.
plot(showLine and snapValid ? trendlineNow : na, "Snapshot trendline",
     color=color.new(color.red, 30), style=plot.style_linebr, linewidth=1)

// Marcadores de pivots highs
plotshape(showPiv and not na(ph), title="Pivot High",
     style=shape.triangledown, location=location.abovebar,
     color=color.new(color.red, 60), size=size.tiny)

// Marcador del breakout (Rule 2) — solo dispara una vez en la vela del cruce
plotshape(breakoutEvent, title="Breakout",
     style=shape.triangleup, location=location.belowbar,
     color=color.new(color.lime, 0), size=size.small, text="↑")

// ============================================================
// TOOLTIPS POR VELA — Hover sobre puntito gris para ver estado
// ============================================================
// Pine v6 NO soporta hover-on-candle directo. Workaround: añadir un
// puntito gris pequeño debajo de cada vela; al pasar el mouse SOBRE
// EL PUNTITO aparece un tooltip con el estado de las reglas en esa
// vela específica. Limitado a las últimas 500 velas (max_labels_count).
if showHoverTooltip
    // Helpers para formatear los valores de diagnóstico
    ph1Str        = na(ph1) ? "—" : str.tostring(ph1, "#.##") + " (hace " + str.tostring(bar_index - ph1x) + " velas)"
    ph2Str        = na(ph2) ? "—" : str.tostring(ph2, "#.##") + " (hace " + str.tostring(bar_index - ph2x) + " velas)"
    dropStr       = hasTwoPivots ? str.tostring(pivotDropPct, "#.##") + "% (min " + str.tostring(minDropPct, "#.##") + "%)" : "—"
    belowBasisStr = hasTwoPivots ? (wasBelowBasisLastPair ? "SÍ ✓" : "NO ✗") : "—"
    trendStr      = snapValid and not na(trendlineNow) ? str.tostring(trendlineNow, "#.##") : "—"
    snapAgeStr    = na(snapBornBar) ? "—" : str.tostring(snapAge) + " velas (max " + str.tostring(recentBars) + ")"
    crossStr      = (snapValid and not na(trendlineNow)) ? (close > trendlineNow ? "SÍ ✓" : "NO ✗") : "—"
    aboveBasisStr = aboveBasis ? "SÍ ✓" : "NO ✗"
    bullStr       = bullishCandle ? "SÍ ✓" : "NO ✗"
    bodyDetailStr = "body=" + str.tostring(candleBody, "#.##") + " atr=" + str.tostring(atr14, "#.##") + " min=" + str.tostring(bodyAtrMult * atr14, "#.##")
    bodyStr       = useBodyFilter ? ((candleBody >= bodyAtrMult * atr14) ? "SÍ ✓ (" + bodyDetailStr + ")" : "NO ✗ (" + bodyDetailStr + ")") : "OFF (filtro desactivado)"
    tooltipTxt = str.format_time(time, "yyyy-MM-dd HH:mm") + " • close=" + str.tostring(close, "#.##") + " • basis=" + str.tostring(basis, "#.##") + "\n─────────\n" + "1. Tendencia bajista: " + (rule1 ? "☑" : "☐") + "\n   ph1 = " + ph1Str + "\n   ph2 = " + ph2Str + "\n   Drop: " + dropStr + "\n   Close < basis entre pivots: " + belowBasisStr + "\n─────────\n" + "2. Ruptura línea tendencia: " + (rule2 ? "☑" : "☐") + "\n   Trendline (snapshot): " + trendStr + "\n   close > trendline: " + crossStr + "\n   Snap age: " + snapAgeStr + "\n─────────\n" + "3. Confirmación BB: " + (rule3 ? "☑" : "☐") + "\n   close > basis: " + aboveBasisStr + "\n   Vela alcista: " + bullStr + "\n   Body filter: " + bodyStr
    label.new(bar_index, high, "", tooltip=tooltipTxt, yloc=yloc.abovebar, color=color.new(color.gray, 70), style=label.style_circle, size=size.tiny, textcolor=color.new(color.white, 100))

// ============================================================
// TABLA DE REGLAS
// ============================================================
f_check(bool b) => b ? "☑" : "☐"
f_bg(bool b)    => b ? color.new(color.green, 60) : color.new(color.red, 70)

var table tbl = na
if showTable and barstate.islast
    table.delete(tbl)
    tbl := table.new(position.top_right, 2, 4,
         bgcolor=color.new(color.black, 20),
         border_color=color.new(color.gray, 50),
         border_width=1)

    // Header
    table.cell(tbl, 0, 0, "REGLAS DE LA ESTRATEGIA",
         text_color=color.white, bgcolor=color.new(color.blue, 30),
         text_halign=text.align_left)
    table.cell(tbl, 1, 0, syminfo.ticker + " · " + tfHuman,
         text_color=color.white, bgcolor=color.new(color.blue, 30))

    // Regla 1 (etiqueta dinámica con TF actual)
    table.cell(tbl, 0, 1, "1. Tendencia bajista (" + tfHuman + ")",
         text_color=color.white, text_halign=text.align_left)
    table.cell(tbl, 1, 1, f_check(rule1),
         text_color=color.white, bgcolor=f_bg(rule1))

    // Regla 2 — Ruptura de la línea
    table.cell(tbl, 0, 2, "2. Ruptura línea de tendencia",
         text_color=color.white, text_halign=text.align_left)
    table.cell(tbl, 1, 2, f_check(rule2),
         text_color=color.white, bgcolor=f_bg(rule2))

    // Regla 3 — Confirmación con Bollinger Bands
    table.cell(tbl, 0, 3, "3. Confirmación BB (" + tfHuman + ")",
         text_color=color.white, text_halign=text.align_left)
    table.cell(tbl, 1, 3, f_check(rule3),
         text_color=color.white, bgcolor=f_bg(rule3))
