//@version=6
// =============================================================
// INDICATOR: Downtrend Reversal BB 15m (PUT en apertura)
//
// 🎯 ESTRATEGIA: Cambio de tendencia a la baja en 15min
//                (Para operar apenas abra el mercado)
//
// Estrategia OPUESTA a Trendline Reversal BB 15m. Captura el
// momento de apertura cuando hay un gap BAJISTA que rompe
// simultaneamente la trendline alcista (support) del dia anterior
// Y el midpoint del rango del dia anterior, hacia abajo.
//
// Reglas:
//   R1: Tendencia previa alcista o lateral en 15m (basis no bajista)
//   R2: Trendline ALCISTA activa (support, pivot lows ascendentes)
//   R3: Apertura con gap BAJISTA que rompe midpoint Y trendline
//       hacia ABAJO. Solo se evalua en la PRIMERA vela de cada dia.
//   R4: Volatilidad en la apertura (cuerpo/rango >= X * ATR)
//
// Senal: ▼ rojo "PUT" en la vela de apertura cuando se cumplen
// las 4 condiciones simultaneamente.
// =============================================================

indicator("Downtrend Reversal BB 15m", shorttitle="DR-15m",
     overlay=true,
     max_lines_count=500,
     max_labels_count=500)

// =============================================================
// IDIOMA / LANGUAGE
// =============================================================
grpLang = "Idioma / Language"
lang    = input.string("Espanol", "Idioma / Language", options=["Espanol", "English"], group=grpLang,
     tooltip="ES: Selecciona idioma para textos del chart (tooltips, tabla, alertas). Los nombres de inputs siempre se muestran en espanol por limitacion de Pine Script (no soporta texto dinamico en inputs).\n\nEN: Select language for chart text (tooltips, table, alerts). Input names always shown in Spanish due to Pine Script limitation (no dynamic input text supported).")

isES = lang == "Espanol"

// Traducciones / Translations
t_strategy   = isES ? "  CAMBIO DE TENDENCIA A LA BAJA\nEN 15 MINUTOS CON BOLLINGER BANDS" : "      BEARISH TREND REVERSAL\nIN 15 MINUTES WITH BOLLINGER BANDS"
// Nota: el mensaje de alertcondition debe ser const string (limitacion de Pine).
t_off        = "OFF"
t_yes        = isES ? "SI" : "YES"
t_no         = isES ? "no" : "no"
t_open       = isES ? "APER" : "OPEN"
t_intra      = isES ? "intra" : "intra"
t_rule1      = isES ? "1. Tend. previa alcista/lateral" : "1. Previous bullish/lateral"
t_rule2      = isES ? "2. Trendline alcista activa"     : "2. Active bullish trendline"
t_rule3      = isES ? "3. Gap rompe midpoint+linea"     : "3. Gap breaks midpoint+line"
t_rule4      = isES ? "4. Volatilidad apertura"         : "4. Opening volatility"
t_signals    = isES ? "Senales PUT" : "PUT Signals"
t_status     = isES ? "Estado" : "Status"
t_times      = isES ? "Veces"  : "Times"

// =============================================================
// INPUTS
// =============================================================

// Bollinger Bands
grpBB  = "Bollinger Bands"
bbLen  = input.int(20,  "Periodo BB", group=grpBB, minval=2)
bbMult = input.float(2.0, "Desviacion BB", group=grpBB, minval=0.1, step=0.1)

// Linea de tendencia auto-detectada (ALCISTA / support)
grpLine        = "Linea de tendencia (auto-detectada)"
pivotLen       = input.int(3, "Pivot strength (left/right)", group=grpLine, minval=1, maxval=20,
     tooltip="Velas a cada lado para confirmar pivot low. Default 3 para 15m.")
maxBarsForward = input.int(20, "Extension forward (bars)", group=grpLine, minval=5, maxval=100,
     tooltip="Cuantas velas adelante se extiende la linea desde el ultimo pivot. Default 20 = 5 horas en 15m.")
maxLinesKeep   = input.int(30, "Max lineas dibujadas", group=grpLine, minval=5, maxval=200)

// Rango del dia anterior
grpPrev        = "Rango del dia anterior"
showPrevLevels = input.bool(true, "Mostrar high/low/midpoint del dia anterior", group=grpPrev,
     tooltip="Dibuja lineas horizontales en el high, low y midpoint (50%) del dia anterior. El midpoint es la referencia clave de la Regla 3.")
midpointPct    = input.float(0.5, "Midpoint (% del rango)", group=grpPrev, minval=0.0, maxval=1.0, step=0.05,
     tooltip="Posicion del midpoint dentro del rango del dia anterior. 0.5 = 50% (default). Bajar si quieres rotura mas baja.")

// Regla 1 - Tendencia previa alcista/lateral
grpR1            = "Regla 1 - Tendencia previa"
lateralLookback  = input.int(20, "Bars hacia atras (15m)", group=grpR1, minval=5, maxval=100,
     tooltip="Cuantos bars de 15m hacia atras para medir la pendiente del basis. Default 20 = 5 horas atras.")
lateralThreshold = input.float(0.5, "Maxima pendiente bajista permitida (%)", group=grpR1, minval=0.0, step=0.1,
     tooltip="Si la pendiente del basis es > -X%, se considera alcista o lateral (valido para la estrategia). Default 0.5%: pendiente mayor a -0.5% pasa el filtro. 0% = solo alcista estricto.")

// Regla 4 - Volatilidad en la apertura
grpR4         = "Regla 4 - Volatilidad apertura"
useVolFilter  = input.bool(true, "Activar filtro de volatilidad", group=grpR4)
volMultATR    = input.float(1.0, "Rango minimo / ATR(14)", group=grpR4, minval=0.1, step=0.1,
     tooltip="El rango (high - low) de la vela de apertura debe ser >= X * ATR(14). Default 1.0 = al menos 1 ATR.")

// Activacion de reglas (debug)
grpToggles    = "Activacion de reglas (para pruebas)"
useRule1      = input.bool(true, "Activar Regla 1 (tendencia previa)", group=grpToggles)
useRule2      = input.bool(true, "Activar Regla 2 (trendline)", group=grpToggles)
useRule3      = input.bool(true, "Activar Regla 3 (gap rompe midpoint+linea)", group=grpToggles)
useRule4      = input.bool(true, "Activar Regla 4 (volatilidad)", group=grpToggles)
showPrePostSignals = input.bool(false, "Mostrar senales en premarket/postmarket", group=grpToggles,
     tooltip="OFF (default): la senal solo dispara en la primera vela de la sesion REGULAR (9:30 AM ET para US stocks). ON: tambien dispara en la apertura del premarket (~4:00 AM ET) o cualquier otra apertura de sesion.")

// Visualizacion
grpViz          = "Visualizacion"
showLines       = input.bool(true,  "Mostrar lineas de tendencia",       group=grpViz)
onlySignalLines = input.bool(true,  "Solo lineas que dispararon senal",  group=grpViz,
     tooltip="ON: solo se conservan lineas que dispararon senal + la actual. OFF: todas las lineas detectadas.")
showPivots      = input.bool(false, "Mostrar marcadores de pivots",      group=grpViz)
showTable       = input.bool(false, "Mostrar tabla de reglas",           group=grpViz)
showBBLabels    = input.bool(false, "Mostrar etiquetas BB en la escala", group=grpViz)
showTooltip     = input.bool(false, "Tooltips por vela (ultimas 500)",   group=grpViz)

// =============================================================
// BOLLINGER BANDS
// =============================================================
basis = ta.sma(close, bbLen)
dev   = bbMult * ta.stdev(close, bbLen)
upper = basis + dev
lower = basis - dev

bbDisplay = showBBLabels ? display.all : display.pane + display.status_line + display.data_window
plot(basis, "BB basis", color=color.orange, linewidth=2, display=bbDisplay)
p1 = plot(upper, "BB upper", color=color.new(color.gray, 50), display=bbDisplay)
p2 = plot(lower, "BB lower", color=color.new(color.gray, 50), display=bbDisplay)
fill(p1, p2, color=color.new(color.gray, 92))

// =============================================================
// RANGO DEL DIA ANTERIOR (high, low, midpoint)
// =============================================================
[prevHigh, prevLow] = request.security(syminfo.tickerid, "D",
     [high[1], low[1]], lookahead=barmerge.lookahead_off)

prevMidpoint = prevLow + (prevHigh - prevLow) * midpointPct

plot(showPrevLevels ? prevHigh     : na, "Prev Day High", color=color.new(color.gray,  20), linewidth=1, style=plot.style_circles)
plot(showPrevLevels ? prevLow      : na, "Prev Day Low",  color=color.new(color.gray,  20), linewidth=1, style=plot.style_circles)
plot(showPrevLevels ? prevMidpoint : na, "Midpoint",      color=color.new(color.yellow, 0), linewidth=1, style=plot.style_circles)

// =============================================================
// DETECCION DE PRIMERA VELA DE APERTURA
// =============================================================
// Por default usa session.isfirstbar_regular que dispara SOLO en la
// primera vela de la sesion regular (9:30 AM ET para stocks US).
// Si showPrePostSignals = ON, usa ta.change(time("D")) que tambien
// dispara en la apertura del premarket (~4:00 AM ET).
isOpeningBar = showPrePostSignals ? (ta.change(time("D")) != 0) : session.isfirstbar_regular

// =============================================================
// REGLA 1 - Tendencia previa alcista o lateral
// =============================================================
// Mide la pendiente del basis durante los ultimos N bars.
// Si la pendiente es >= -lateralThreshold, consideramos que el
// contexto previo era alcista o lateral (NO bajista).
basisChangePct = (basis - basis[lateralLookback]) / basis[lateralLookback] * 100
rule1 = basisChangePct >= -lateralThreshold

// =============================================================
// REGLA 2 - Trendline ALCISTA auto-detectada (support, pivot lows)
// =============================================================
pl = ta.pivotlow(low, pivotLen, pivotLen)

var float prevPivotLow = na
var int   prevPivotBar = na

var float lineStartPrice = na
var int   lineStartBar   = na
var float lineSlope      = na
var int   lineEndBar     = na

var line  currentLine     = na
var bool  currentHadSignal = false
var array<line> visualLines = array.new<line>()

if not na(pl)
    clD = pl
    cbD = bar_index - pivotLen

    // Par ASCENDENTE -> nueva linea alcista (support)
    if not na(prevPivotLow) and clD > prevPivotLow
        bdD = cbD - prevPivotBar
        slD = (clD - prevPivotLow) / float(bdD)
        fbD = cbD + maxBarsForward
        fpD = clD + slD * maxBarsForward

        lineStartPrice := prevPivotLow
        lineStartBar   := prevPivotBar
        lineSlope      := slD
        lineEndBar     := fbD

        if showLines
            if not na(currentLine)
                if currentHadSignal or not onlySignalLines
                    array.push(visualLines, currentLine)
                    if array.size(visualLines) > maxLinesKeep
                        oldL = array.shift(visualLines)
                        line.delete(oldL)
                else
                    line.delete(currentLine)

            currentLine      := line.new(prevPivotBar, prevPivotLow, fbD, fpD,
                 extend=extend.none, color=color.new(color.lime, 0),
                 width=2, style=line.style_dashed)
            currentHadSignal := false

    prevPivotLow := clD
    prevPivotBar := cbD

plotshape(showPivots and not na(pl), title="Pivot Low",
     style=shape.circle, location=location.belowbar,
     color=color.new(color.aqua, 0), size=size.tiny, offset=-pivotLen)

trendlineActive = not na(lineStartPrice) and not na(lineEndBar) and bar_index <= lineEndBar
trendlineNow    = trendlineActive ? lineStartPrice + lineSlope * (bar_index - lineStartBar) : na

rule2 = trendlineActive

// =============================================================
// REGLA 3 - Apertura con gap BAJISTA que rompe midpoint Y trendline
// =============================================================
// SOLO se evalua en la PRIMERA vela del dia (isOpeningBar = true).
// El precio de apertura (open) debe estar SIMULTANEAMENTE debajo de:
//   (a) el midpoint del rango del dia anterior
//   (b) la trendline alcista activa (support)
//
// Esta es la condicion clave que define el "amanece con salto bajista".
// =============================================================
gapBreaksMidpoint  = not na(prevMidpoint) and open < prevMidpoint
gapBreaksTrendline = not na(trendlineNow) and open < trendlineNow

rule3 = isOpeningBar and gapBreaksMidpoint and gapBreaksTrendline

// =============================================================
// REGLA 4 - Volatilidad en la apertura
// =============================================================
atr14   = ta.atr(14)
barRng  = high - low
rule4   = (not useVolFilter) or (barRng >= volMultATR * atr14)

// =============================================================
// SENAL COMPLETA
// =============================================================
effR1 = (not useRule1) or rule1
effR2 = (not useRule2) or rule2
effR3 = (not useRule3) or rule3
effR4 = (not useRule4) or rule4

fullSignal    = effR1 and effR2 and effR3 and effR4
breakoutEvent = fullSignal and not fullSignal[1]

if breakoutEvent
    currentHadSignal := true

// =============================================================
// CONTADORES
// =============================================================
var int countR1     = 0
var int countR2     = 0
var int countR3     = 0
var int countR4     = 0
var int countSignal = 0

if rule1 and not rule1[1]
    countR1 += 1
if rule2 and not rule2[1]
    countR2 += 1
if rule3 and not rule3[1]
    countR3 += 1
if rule4 and not rule4[1]
    countR4 += 1
if breakoutEvent
    countSignal += 1

plotshape(breakoutEvent, title="DOWN Signal",
     style=shape.triangledown, location=location.abovebar,
     color=color.new(color.red, 0), size=size.small)

// Texto "DW" via label.new para soportar tooltip nativo en hover.
if breakoutEvent
    label.new(bar_index, high, "DW",
         yloc=yloc.abovebar,
         style=label.style_none,
         textcolor=color.new(color.red, 0),
         size=size.small,
         tooltip=t_strategy)

alertcondition(breakoutEvent, title="PUT opening signal", message="DR-15m PUT apertura / opening {{ticker}} @ {{close}}")

// EXPORT A CSV: plotshape/alertcondition NO se exportan con "Export chart data" (solo plot()).
// Esta serie pone 1 en la vela de la senal -> columna "Signal PUT" en el CSV. data_window = no ensucia el chart.
plot(breakoutEvent ? 1 : na, "Signal PUT", display=display.data_window)

// =============================================================
// TABLA DE REGLAS
// =============================================================
f_check(bool b) => b ? "[X]" : "[ ]"
f_bg(bool b)    => b ? color.new(color.green, 60) : color.new(color.gray, 70)

var table tbl = na
if showTable and barstate.islast
    table.delete(tbl)
    tbl := table.new(position.top_right, 3, 7,
         bgcolor=color.new(color.black, 20),
         border_color=color.new(color.gray, 50), border_width=1)

    table.cell(tbl, 0, 0, "DR-15m",
         text_color=color.white, bgcolor=color.new(color.blue, 30), text_halign=text.align_left)
    table.cell(tbl, 1, 0, t_status,
         text_color=color.white, bgcolor=color.new(color.blue, 30))
    table.cell(tbl, 2, 0, t_times,
         text_color=color.white, bgcolor=color.new(color.blue, 30))

    table.cell(tbl, 0, 1, syminfo.ticker,
         text_color=color.gray, bgcolor=color.new(color.black, 50), text_halign=text.align_left)
    table.cell(tbl, 1, 1, isOpeningBar ? t_open : t_intra,
         text_color=color.gray, bgcolor=color.new(color.black, 50))
    table.cell(tbl, 2, 1, "",
         text_color=color.gray, bgcolor=color.new(color.black, 50))

    table.cell(tbl, 0, 2, t_rule1,
         text_color=color.white, text_halign=text.align_left)
    table.cell(tbl, 1, 2, f_check(rule1),
         text_color=color.white, bgcolor=f_bg(rule1))
    table.cell(tbl, 2, 2, str.tostring(countR1),
         text_color=color.white)

    table.cell(tbl, 0, 3, t_rule2,
         text_color=color.white, text_halign=text.align_left)
    table.cell(tbl, 1, 3, f_check(rule2),
         text_color=color.white, bgcolor=f_bg(rule2))
    table.cell(tbl, 2, 3, str.tostring(countR2),
         text_color=color.white)

    table.cell(tbl, 0, 4, t_rule3,
         text_color=color.white, text_halign=text.align_left)
    table.cell(tbl, 1, 4, f_check(rule3),
         text_color=color.white, bgcolor=f_bg(rule3))
    table.cell(tbl, 2, 4, str.tostring(countR3),
         text_color=color.white)

    table.cell(tbl, 0, 5, t_rule4,
         text_color=color.white, text_halign=text.align_left)
    table.cell(tbl, 1, 5, f_check(rule4),
         text_color=color.white, bgcolor=f_bg(rule4))
    table.cell(tbl, 2, 5, str.tostring(countR4),
         text_color=color.white)

    table.cell(tbl, 0, 6, t_signals,
         text_color=color.white, bgcolor=color.new(color.red, 70), text_halign=text.align_left)
    table.cell(tbl, 1, 6, "",
         text_color=color.white, bgcolor=color.new(color.red, 70))
    table.cell(tbl, 2, 6, str.tostring(countSignal),
         text_color=color.white, bgcolor=color.new(color.red, 50))

// =============================================================
// TOOLTIP POR VELA
// =============================================================
if showTooltip
    midStr   = na(prevMidpoint) ? "n/a" : str.tostring(prevMidpoint, "#.##")
    trendStr = na(trendlineNow) ? "n/a" : str.tostring(trendlineNow, "#.##")
    openStr  = isOpeningBar ? "YES" : "no"
    txt = str.format_time(time, "yyyy-MM-dd HH:mm") + " open=" + str.tostring(open, "#.##") + " close=" + str.tostring(close, "#.##") + "\nopening_bar=" + openStr + " mid=" + midStr + " trend=" + trendStr + "\nR1=" + f_check(rule1) + " R2=" + f_check(rule2) + " R3=" + f_check(rule3) + " R4=" + f_check(rule4) + " SIGNAL=" + f_check(fullSignal)
    label.new(bar_index, low, "", tooltip=txt, yloc=yloc.belowbar,
         color=color.new(color.gray, 70), style=label.style_circle, size=size.tiny,
         textcolor=color.new(color.white, 100))
