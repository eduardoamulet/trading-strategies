//@version=6
// ============================================================================
//  Markov 2.0 - Hedge Fund Method (corrected)
//  Régimen de mercado por cadena de Markov, con las 3 correcciones del método:
//   FIX 1  STRIDE SAMPLING. La matriz "honesta" cuenta transiciones entre ventanas
//          NO solapadas (stride = ventana). La "legacy" (overlapping, stride=1)
//          comparte N-1 de N barras y FALSEA la persistencia de la diagonal.
//          La tabla muestra el % stride y, entre paréntesis, el % overlapping.
//   FIX 2  Estados por umbral explícito sobre el retorno de N barras (sin magia).
//   FIX 3  Salida CLARA: clasificación BEAR/SIDEWAYS/BULL + un score 0-100
//          (0 = lo más BEAR · 100 = lo más BULL) en la fila TENDENCIA.
//
//  Señal = P(bull) - P(bear) leído de la fila del estado ACTUAL en la matriz stride.
//  Aviso honesto: es una lectura de RÉGIMEN/contexto, no una promesa de ganancia.
// ============================================================================
indicator("Markov 2.0 - Hedge Fund Method (corrected)", shorttitle="Markov 2.0", overlay=true, max_bars_back=600)

// ─────────────────────────── Inputs ───────────────────────────
gS = "Estados (régimen)"
winLen  = input.int(20, "Ventana (barras)", minval=2, maxval=500, group=gS, tooltip="Retorno acumulado de N barras que define el régimen (20 = clásico).")
upPct   = input.float(5.0,  "Umbral BULL (%)", group=gS, tooltip="Retorno N-barras ≥ esto = BULL.") / 100.0
downPct = input.float(-5.0, "Umbral BEAR (%)", group=gS, tooltip="Retorno N-barras ≤ esto = BEAR.") / 100.0
edgeThr = input.float(10.0, "Umbral edge (señal %)", minval=0, group=gS, tooltip="|bull-bear| mínima para declarar dirección; por debajo = NO EDGE.") / 100.0

gT = "Tabla"
tabPos  = input.string("Arriba derecha", "Posición", options=["Arriba derecha", "Arriba izquierda", "Abajo derecha", "Abajo izquierda", "Medio derecha"], group=gT)
txtSize = input.string("Normal", "Tamaño de texto", options=["Chico", "Normal", "Grande"], group=gT)
showBg  = input.bool(false, "Pintar fondo del precio por régimen", group=gT)

// ─────────────────── Estado: 0=BEAR · 1=SIDEWAYS · 2=BULL ───────────────────
ret   = close / close[winLen] - 1.0
state = na(close[winLen]) ? na : (ret >= upPct ? 2 : (ret <= downPct ? 0 : 1))

// ───────── Matrices de conteo: overlapping (stride=1) y stride (=winLen) ─────────
var matrix<float> Co = matrix.new<float>(3, 3, 0.0)
var matrix<float> Cs = matrix.new<float>(3, 3, 0.0)

// Solo en barras CONFIRMADas (cada barra cuenta una vez; nunca la barra en formación).
if barstate.isconfirmed
    s0 = state
    s1 = state[1]
    sw = state[winLen]
    if not na(s0) and not na(s1)
        matrix.set(Co, int(s1), int(s0), matrix.get(Co, int(s1), int(s0)) + 1.0)
    if not na(s0) and not na(sw)
        matrix.set(Cs, int(sw), int(s0), matrix.get(Cs, int(sw), int(s0)) + 1.0)

// Probabilidad de la celda (fila r → col c) normalizando la fila. na si la fila no se vio.
f_prob(m, r, c) =>
    rs = matrix.get(m, r, 0) + matrix.get(m, r, 1) + matrix.get(m, r, 2)
    rs > 0 ? matrix.get(m, r, c) / rs : na

f_name(i)   => i == 0 ? "BEAR" : i == 1 ? "SIDEWAYS" : i == 2 ? "BULL" : "—"
f_signed(x) => (x >= 0 ? "+" : "") + str.tostring(x, "#.#")
f_pct(p)    => na(p) ? "—" : str.tostring(p * 100, "#") + "%"

// ───────── Tendencia 0-100 (0=BEAR · 50=SIDEWAYS · 100=BULL) ─────────
// Del retorno de N barras: ±5% (bordes) → 25/75, ±10% → 0/100, plano → 50.
tendencia = na(ret) ? na : math.max(0.0, math.min(100.0, 50.0 + ret * 500.0))
plot(tendencia, "Tendencia 0-100", color=color.blue, display=display.data_window)

// Fondo opcional por régimen.
bgcolor(showBg and not na(state) ? (state == 2 ? color.new(color.green, 90) : state == 0 ? color.new(color.red, 90) : color.new(color.gray, 93)) : na)

// ─────────────────────────── Render de la tabla ───────────────────────────
f_tabpos() =>
    switch tabPos
        "Arriba izquierda" => position.top_left
        "Abajo derecha"    => position.bottom_right
        "Abajo izquierda"  => position.bottom_left
        "Medio derecha"    => position.middle_right
        => position.top_right

f_tabsize() =>
    switch txtSize
        "Chico"  => size.small
        "Grande" => size.large
        => size.normal

var table tb = table.new(f_tabpos(), 4, 7, border_width=1, frame_width=1, frame_color=color.new(color.gray, 40))

if barstate.islast
    sz   = f_tabsize()
    cur  = na(state) ? -1 : int(state)
    cHd  = color.new(color.gray, 82)     // header / etiquetas
    cDg  = color.new(color.orange, 78)   // diagonal
    cBd  = color.new(color.gray, 90)     // celda normal del cuerpo
    cTx  = color.new(color.black, 0)

    // Encabezado
    table.cell(tb, 0, 0, "Desde \\ Hacia", text_color=color.gray, text_size=sz, bgcolor=cHd, text_halign=text.align_left)
    for c = 0 to 2
        table.cell(tb, c + 1, 0, f_name(c), text_color=cTx, text_size=sz, bgcolor=cHd)

    // Filas de la matriz: "<stride%> (<overlapping%>)" · diagonal resaltada · estado actual con ←
    for r = 0 to 2
        rmark = (r == cur) ? " ←" : ""
        rcol  = (r == cur) ? (r == 2 ? color.green : r == 0 ? color.red : color.orange) : color.gray
        table.cell(tb, 0, r + 1, f_name(r) + rmark, text_color=rcol, text_size=sz, bgcolor=cHd, text_halign=text.align_left)
        for c = 0 to 2
            cellTxt = f_pct(f_prob(Cs, r, c)) + " (" + f_pct(f_prob(Co, r, c)) + ")"
            table.cell(tb, c + 1, r + 1, cellTxt, text_color=cTx, text_size=sz, bgcolor=(r == c ? cDg : cBd))

    // Señal = P(bull) - P(bear) de la fila del estado actual (matriz stride)
    sig     = cur < 0 ? na : (f_prob(Cs, cur, 2) - f_prob(Cs, cur, 0))
    isEdge  = not na(sig) and math.abs(sig) >= edgeThr
    verdict = na(sig) ? "—" : (isEdge ? (sig > 0 ? "BULLISH" : "BEARISH") : "NO EDGE")
    action  = na(sig) ? "" : (isEdge ? (sig > 0 ? "lean long" : "lean short") : "stay flat")
    vcol    = na(sig) ? color.gray : (isEdge ? (sig > 0 ? color.green : color.red) : color.gray)

    // TODAY
    table.cell(tb, 0, 4, "TODAY", text_color=color.gray, text_size=sz, bgcolor=cHd, text_halign=text.align_left)
    table.cell(tb, 1, 4, cur < 0 ? "—" : f_name(cur), text_color=cur == 2 ? color.green : cur == 0 ? color.red : color.orange, text_size=sz, bgcolor=cHd)
    table.cell(tb, 2, 4, na(ret) ? "—" : f_signed(ret * 100) + "%", text_color=cTx, text_size=sz, bgcolor=cHd)
    table.cell(tb, 3, 4, "/" + str.tostring(winLen) + " barras", text_color=color.gray, text_size=sz, bgcolor=cHd)

    // SIGNAL  (bull−bear → veredicto → acción)
    table.cell(tb, 0, 5, "SIGNAL", text_color=color.gray, text_size=sz, bgcolor=cHd, text_halign=text.align_left)
    table.cell(tb, 1, 5, na(sig) ? "—" : f_signed(sig * 100) + "%", text_color=vcol, text_size=sz, bgcolor=cHd)
    table.cell(tb, 2, 5, verdict, text_color=vcol, text_size=sz, bgcolor=cHd)
    table.cell(tb, 3, 5, action, text_color=color.gray, text_size=sz, bgcolor=cHd)

    // TENDENCIA 0-100  (0 = lo más BEAR · 100 = lo más BULL)
    tcol = na(tendencia) ? color.gray : color.from_gradient(tendencia, 0.0, 100.0, color.red, color.green)
    table.cell(tb, 0, 6, "TENDENCIA", text_color=color.gray, text_size=sz, bgcolor=cHd, text_halign=text.align_left)
    table.cell(tb, 1, 6, na(tendencia) ? "—" : str.tostring(tendencia, "#") + "/100", text_color=tcol, text_size=sz, bgcolor=cHd)
    table.cell(tb, 2, 6, "0=BEAR", text_color=color.new(color.red, 20), text_size=sz, bgcolor=cHd)
    table.cell(tb, 3, 6, "100=BULL", text_color=color.new(color.green, 20), text_size=sz, bgcolor=cHd)

// ─────────────────────────── Alertas ───────────────────────────
alertcondition(ta.change(state) != 0, "Cambio de régimen", "Markov 2.0: el régimen cambió de estado (BEAR/SIDEWAYS/BULL).")
