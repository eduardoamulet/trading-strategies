//@version=5
indicator("Bollinger - Expansión Divergente + Alta Volatilidad", overlay=true)

// ============================================================================
// INPUTS
// ============================================================================
grpBB = "Bandas de Bollinger"
length = input.int(20, "Período BB", minval=1, group=grpBB)
mult   = input.float(2.0, "Multiplicador StdDev", minval=0.1, step=0.1, group=grpBB)
src    = input.source(close, "Fuente", group=grpBB)

grpVol = "Filtro de Volatilidad"
volLen      = input.int(20, "Período media BB Width", minval=2, group=grpVol, tooltip="Período sobre el cual se promedia el ancho de banda para definir 'volatilidad normal'.")
volMult     = input.float(1.20, "Umbral Vol Alta (× media)", minval=1.0, step=0.05, group=grpVol, tooltip="BB Width debe superar la media × este multiplicador para considerarse 'volatilidad alta'. 1.20 = 20% por encima de la media.")
requireBoth = input.bool(true, "Exigir expansión + vol alta a la vez", group=grpVol, tooltip="Si está activo: la marca roja solo aparece cuando BOTH bandas divergen Y la volatilidad es alta. Si está desactivo: aparece con cualquiera de las dos.")

grpExp = "Filtro de Expansión Divergente"
minSlopePct = input.float(0.0, "Pendiente mínima (% precio)", minval=0.0, step=0.01, group=grpExp, tooltip="0 = detecta cualquier apertura. Sube a 0.02 para filtrar micro-movimientos en timeframes pequeños.")
minBars     = input.int(1, "Mín. barras consecutivas", minval=1, group=grpExp)

grpStyle = "Estilo"
showBg     = input.bool(true,  "Fondo rojo en alta volatilidad", group=grpStyle)
showStart  = input.bool(true,  "Marcar inicio de evento",        group=grpStyle)
showLabel  = input.bool(true,  "Etiqueta 'VOL ALTA'",            group=grpStyle)
fillBands  = input.bool(true,  "Rellenar área entre bandas",     group=grpStyle)
basisColor = input.color(color.new(color.orange, 0), "Color Basis", group=grpStyle)
bandColor  = input.color(color.new(color.blue,   0), "Color Bandas (normal)",       group=grpStyle)
alertColor = input.color(color.new(color.red,    0), "Color Bandas (vol alta)",     group=grpStyle)
bandWidth  = input.int(2, "Grosor Bandas", minval=1, maxval=4, group=grpStyle)

// ============================================================================
// CÁLCULO BB
// ============================================================================
basis = ta.sma(src, length)
dev   = mult * ta.stdev(src, length)
upper = basis + dev
lower = basis - dev

// ============================================================================
// 1) DETECCIÓN: bandas abriéndose en sentido contrario
// ============================================================================
threshold    = close * minSlopePct / 100.0
upperRising  = (upper - upper[1]) >  threshold
lowerFalling = (lower - lower[1]) < -threshold
rawDivergent = upperRising and lowerFalling

// Confirmación: N barras consecutivas
var int consec = 0
consec := rawDivergent ? consec + 1 : 0
divergent = consec >= minBars

// ============================================================================
// 2) DETECCIÓN: VOLATILIDAD ALTA via BB Width
// ============================================================================
bbWidth    = (upper - lower) / basis * 100.0   // ancho relativo en %
bbWidthAvg = ta.sma(bbWidth, volLen)
highVol    = bbWidth > bbWidthAvg * volMult

// ============================================================================
// 3) CONDICIÓN COMBINADA (lo que se marca en rojo)
// ============================================================================
trigger     = requireBoth ? (divergent and highVol) : (divergent or highVol)
newTrigger  = trigger and not trigger[1]

// ============================================================================
// PLOT — bandas se vuelven rojas en los bars donde se cumple
// ============================================================================
plot(basis, color=basisColor, title="Basis (SMA)")
upperPlot = plot(upper, color=trigger ? alertColor : bandColor, linewidth=bandWidth, title="Banda Superior")
lowerPlot = plot(lower, color=trigger ? alertColor : bandColor, linewidth=bandWidth, title="Banda Inferior")

fill(upperPlot, lowerPlot, color=fillBands ? (trigger ? color.new(color.red, 90) : color.new(color.blue, 92)) : na, title="Fill BB")

bgcolor(showBg and trigger ? color.new(color.red, 88) : na, title="Fondo Vol Alta")

plotshape(showStart and newTrigger, title="Inicio Vol Alta", style=shape.triangleup, location=location.bottom, color=color.new(color.red, 0), size=size.small, text="VOL")

// Etiqueta flotante "VOL ALTA" sobre la banda superior
if showLabel and newTrigger
    label.new(bar_index, upper, "VOL ALTA", style=label.style_label_down, color=color.new(color.red, 20), textcolor=color.white, size=size.small)

// ============================================================================
// DIAGNÓSTICO (panel de datos en la esquina)
// ============================================================================
var table info = table.new(position.top_right, 2, 4, bgcolor=color.new(color.black, 70), border_width=1)
if barstate.islast
    table.cell(info, 0, 0, "BB Width",   text_color=color.white, text_size=size.small)
    table.cell(info, 1, 0, str.tostring(bbWidth, "#.##") + " %", text_color=color.white, text_size=size.small)
    table.cell(info, 0, 1, "Media",      text_color=color.white, text_size=size.small)
    table.cell(info, 1, 1, str.tostring(bbWidthAvg, "#.##") + " %", text_color=color.white, text_size=size.small)
    table.cell(info, 0, 2, "Vol Alta",   text_color=color.white, text_size=size.small)
    table.cell(info, 1, 2, highVol ? "SI" : "no", text_color=highVol ? color.red : color.gray, text_size=size.small)
    table.cell(info, 0, 3, "Divergente", text_color=color.white, text_size=size.small)
    table.cell(info, 1, 3, divergent ? "SI" : "no", text_color=divergent ? color.red : color.gray, text_size=size.small)

// ============================================================================
// ALERTAS
// ============================================================================
alertcondition(newTrigger,           title="Inicio Vol Alta",  message="Volatilidad ALTA + expansión divergente en {{ticker}} @ {{close}}")
alertcondition(trigger and not newTrigger, title="Vol Alta activa", message="Continúa la volatilidad alta en {{ticker}}")
