//@version=6
// =============================================================
// INDICATOR: Apertura NY — Estrategia ICT / Smart Money Concepts
// Basado en "Estrategia de Trading para Apertura" (Moissane Hernandez)
// Marco recomendado: 5 min sobre SPY / QQQ
//
// Señales primarias (LONG/SHORT) cuando se cumplen todas las reglas:
//   1) Kill Zone NY Open 9:30-11:00 ET activa
//   2) Han cerrado los primeros 15 min (OR ya definido)
//   3) Vela rompe el swing high/low del OR de 15 min
//   4) Cierre por encima/debajo del VWAP de sesión
//   5) Volumen > SMA(20) de volumen
//
// Señales de continuación / "add" tras el primario:
//   - Pin bar con volumen bajo en el retroceso + siguiente vela
//     rompe el extremo de la pin bar → marcador de continuación
//
// Visual de contexto:
//   - PDH / PDL del día anterior
//   - Opening Range (caja) de los primeros 15 min
//   - VWAP de sesión
//   - Cajas de Order Block (heurístico: vela contraria previa a
//     displacement > N × ATR14)
//   - Cajas de Fair Value Gap (3 velas, gap mínimo configurable)
//   - Marcadores de impulso 3+ velas y pin bars
//
// NO incluye TP/SL ni back-testing: indicador puro.
// =============================================================

indicator("Apertura NY ICT — 5min", shorttitle="Apertura ICT",
     overlay=true,
     max_boxes_count=500,
     max_lines_count=500,
     max_labels_count=500)

// =============================================================
// INPUTS
// =============================================================
G_SESS = "Sesión"
killStart  = input.session("0930-1100", "Kill Zone NY Open",  group=G_SESS)
firstWin   = input.session("0930-0945", "Primeros 15 min",    group=G_SESS, tooltip="Ventana usada para calcular el Opening Range")
tz         = input.string("America/New_York", "Zona horaria", group=G_SESS)

G_LVL = "Niveles de contexto"
showPDHPDL  = input.bool(true, "PDH / PDL",            group=G_LVL)
showVWAP    = input.bool(true, "VWAP de sesión",       group=G_LVL)
showOR      = input.bool(true, "Opening Range (15m)",  group=G_LVL)
showKZbg    = input.bool(true, "Sombreado Kill Zone",  group=G_LVL)

G_ZONES = "Order Blocks & FVG"
showOB        = input.bool(true,  "Detectar Order Blocks",      group=G_ZONES)
showFVG       = input.bool(true,  "Detectar Fair Value Gaps",   group=G_ZONES)
displaceMult  = input.float(1.5,  "Displacement (× ATR14)",     minval=0.5, step=0.1, group=G_ZONES, tooltip="Tamaño mínimo del cuerpo de la vela de impulso, en múltiplos del ATR(14)")
minFVGSize    = input.float(0.10, "FVG mínimo (precio)",        minval=0.0, step=0.01, group=G_ZONES, tooltip="Tamaño mínimo del gap en unidades de precio. PDF sugiere 0.15 para SPY")
maxOBs        = input.int(5,      "Máx Order Blocks visibles",  minval=1, maxval=20, group=G_ZONES)
maxFVGs       = input.int(5,      "Máx FVG visibles",           minval=1, maxval=20, group=G_ZONES)
restrictKZ    = input.bool(true,  "Sólo crear OB/FVG dentro del Kill Zone", group=G_ZONES)

G_SIG = "Señales"
volMaLen    = input.int(20,   "Longitud SMA de volumen",  minval=2, group=G_SIG)
pinRatio    = input.float(0.55,"Mecha mínima / rango total", minval=0.30, maxval=0.90, step=0.05, group=G_SIG, tooltip="Para considerar una vela como pin bar")
showSignals = input.bool(true, "Marcar señales LONG/SHORT primarias", group=G_SIG)
showCont    = input.bool(true, "Marcar señales de continuación",      group=G_SIG)
showImpulse = input.bool(true, "Marcar impulso inicial 3+ velas",     group=G_SIG)
showPin     = input.bool(true, "Marcar pin bars",                     group=G_SIG)
oneSigPerSession = input.bool(true, "Sólo 1 señal primaria por sesión", group=G_SIG)

G_TP = "Take Profits (TP1 / TP2)"
showTP1      = input.bool(true,  "Mostrar TP1",                   group=G_TP)
showTP2      = input.bool(true,  "Mostrar TP2 (trailing)",        group=G_TP)
useDoubleEnd = input.bool(true,  "Incluir doble techo / fondo",   group=G_TP)
pivotBars    = input.int(2,      "Barras pivote (doble t/f)",     minval=1, maxval=10, group=G_TP)
doubleTolAtr = input.float(0.5,  "Tolerancia doble t/f (×ATR14)", minval=0.0, step=0.1, group=G_TP)
showTPLines  = input.bool(true,  "Dibujar líneas objetivo y trailing", group=G_TP)

// =============================================================
// SESSION DETECTION
// =============================================================
inKZ      = not na(time(timeframe.period, killStart, tz))
inFirst15 = not na(time(timeframe.period, firstWin, tz))

newKZ = inKZ and not inKZ[1]

// =============================================================
// PDH / PDL  (yesterday's high / low, no lookahead)
// =============================================================
pdh = request.security(syminfo.tickerid, "D", high[1], lookahead=barmerge.lookahead_on)
pdl = request.security(syminfo.tickerid, "D", low[1],  lookahead=barmerge.lookahead_on)

var line pdhLn = na
var line pdlLn = na
if showPDHPDL and newKZ
    line.delete(pdhLn)
    line.delete(pdlLn)
    pdhLn := line.new(bar_index, pdh, bar_index + 1, pdh, extend=extend.right,
         color=color.new(color.red,   0), style=line.style_dashed, width=1)
    pdlLn := line.new(bar_index, pdl, bar_index + 1, pdl, extend=extend.right,
         color=color.new(color.green, 0), style=line.style_dashed, width=1)

// =============================================================
// OPENING RANGE  (first 15 min — 3 velas de 5m)
// =============================================================
var float orHigh = na
var float orLow  = na
var bool  orDone = false
var box   orBox  = na
var line  orHiLn = na
var line  orLoLn = na

if newKZ
    orHigh := na
    orLow  := na
    orDone := false
    box.delete(orBox)
    line.delete(orHiLn)
    line.delete(orLoLn)

if inFirst15
    orHigh := na(orHigh) ? high : math.max(orHigh, high)
    orLow  := na(orLow)  ? low  : math.min(orLow,  low)

// First bar AFTER the OR window closes → finalize OR
if inFirst15[1] and not inFirst15 and not orDone
    orDone := true
    if showOR
        orBox  := box.new(bar_index - 3, orHigh, bar_index, orLow,
             border_color=color.new(color.yellow, 40),
             bgcolor=color.new(color.yellow, 90))
        orHiLn := line.new(bar_index, orHigh, bar_index + 1, orHigh,
             extend=extend.right, color=color.new(color.yellow, 10), width=1)
        orLoLn := line.new(bar_index, orLow,  bar_index + 1, orLow,
             extend=extend.right, color=color.new(color.yellow, 10), width=1)

// =============================================================
// VWAP de sesión
// =============================================================
vwapVal = ta.vwap(hlc3)
plot(showVWAP ? vwapVal : na, "VWAP", color=color.new(color.orange, 0), linewidth=2)

// =============================================================
// VOLUME MA
// =============================================================
volMA = ta.sma(volume, volMaLen)
volOK = volume > volMA

// =============================================================
// IMPULSO inicial — 3+ velas en la misma dirección
// =============================================================
var int bullCount = 0
var int bearCount = 0
bullCount := close > open ? bullCount + 1 : 0
bearCount := close < open ? bearCount + 1 : 0

impulseUpNew   = bullCount >= 3 and nz(bullCount[1]) < 3
impulseDownNew = bearCount >= 3 and nz(bearCount[1]) < 3

plotshape(showImpulse and impulseUpNew,
     "Impulso alcista", shape.triangleup, location.belowbar,
     color=color.new(color.aqua, 0), size=size.tiny)
plotshape(showImpulse and impulseDownNew,
     "Impulso bajista", shape.triangledown, location.abovebar,
     color=color.new(color.fuchsia, 0), size=size.tiny)

// =============================================================
// PIN BAR (mecha larga)
// =============================================================
rng    = high - low
body   = math.abs(close - open)
upWick = high - math.max(close, open)
dnWick = math.min(close, open) - low

bullPin = rng > 0 and (dnWick / rng) >= pinRatio and close >= open
bearPin = rng > 0 and (upWick / rng) >= pinRatio and close <= open

plotshape(showPin and bullPin, "Bull Pin", shape.diamond, location.belowbar,
     color=color.new(color.lime, 0), size=size.tiny)
plotshape(showPin and bearPin, "Bear Pin", shape.diamond, location.abovebar,
     color=color.new(color.red, 0),  size=size.tiny)

// =============================================================
// FAIR VALUE GAPS (3 velas)
//   Bullish FVG:  low[0] > high[2]    → zona = [high[2], low[0]]
//   Bearish FVG:  high[0] < low[2]    → zona = [high[0], low[2]]
// =============================================================
var array<box> fvgBullArr = array.new<box>()
var array<box> fvgBearArr = array.new<box>()

bullFVG = low > high[2] and (low - high[2]) >= minFVGSize
bearFVG = high < low[2] and (low[2] - high) >= minFVGSize

canDraw = (not restrictKZ) or inKZ

if showFVG and bullFVG and canDraw
    bx = box.new(bar_index - 2, low, bar_index + 10, high[2],
         border_color=color.new(color.green, 30),
         bgcolor=color.new(color.green, 85),
         extend=extend.right)
    array.push(fvgBullArr, bx)
    if array.size(fvgBullArr) > maxFVGs
        box.delete(array.shift(fvgBullArr))

if showFVG and bearFVG and canDraw
    bx = box.new(bar_index - 2, low[2], bar_index + 10, high,
         border_color=color.new(color.red, 30),
         bgcolor=color.new(color.red, 85),
         extend=extend.right)
    array.push(fvgBearArr, bx)
    if array.size(fvgBearArr) > maxFVGs
        box.delete(array.shift(fvgBearArr))

// =============================================================
// ORDER BLOCKS (heurístico)
//   Bullish OB: vela bajista cuyo siguiente bar es displacement alcista
//   Bearish OB: vela alcista cuyo siguiente bar es displacement bajista
//   Displacement = body > displaceMult × ATR(14)
// =============================================================
atr14 = ta.atr(14)
bullDispl = close > open and body > displaceMult * atr14
bearDispl = close < open and body > displaceMult * atr14

var array<box> obBullArr = array.new<box>()
var array<box> obBearArr = array.new<box>()

if showOB and bullDispl and close[1] < open[1] and canDraw
    bx = box.new(bar_index - 1, high[1], bar_index + 10, low[1],
         border_color=color.new(color.teal, 20),
         bgcolor=color.new(color.teal, 80),
         extend=extend.right)
    array.push(obBullArr, bx)
    if array.size(obBullArr) > maxOBs
        box.delete(array.shift(obBullArr))

if showOB and bearDispl and close[1] > open[1] and canDraw
    bx = box.new(bar_index - 1, high[1], bar_index + 10, low[1],
         border_color=color.new(color.maroon, 20),
         bgcolor=color.new(color.maroon, 80),
         extend=extend.right)
    array.push(obBearArr, bx)
    if array.size(obBearArr) > maxOBs
        box.delete(array.shift(obBearArr))

// =============================================================
// PRIMARY ENTRY SIGNALS  (reglas 3–5 del PDF)
// =============================================================
canTrade = inKZ and orDone and not na(orHigh) and not na(orLow)

longBreak  = canTrade and close > open and close > orHigh and close > vwapVal and volOK
shortBreak = canTrade and close < open and close < orLow  and close < vwapVal and volOK

var bool longTaken  = false
var bool shortTaken = false
if newKZ
    longTaken  := false
    shortTaken := false

longSignal  = longBreak  and (not oneSigPerSession or not longTaken)
shortSignal = shortBreak and (not oneSigPerSession or not shortTaken)

if longSignal
    longTaken := true
if shortSignal
    shortTaken := true

plotshape(showSignals and longSignal,
     "LONG", shape.triangleup, location.belowbar,
     color=color.new(color.green, 0), size=size.normal, text="LONG", textcolor=color.white)
plotshape(showSignals and shortSignal,
     "SHORT", shape.triangledown, location.abovebar,
     color=color.new(color.red, 0), size=size.normal, text="SHORT", textcolor=color.white)

// =============================================================
// CONTINUATION SIGNALS  (regla 6 del PDF)
//   Tras señal primaria, pin bar con volumen bajo + siguiente vela
//   rompe el extremo de la pin bar = "add" / continuación.
// =============================================================
contLong  = showCont and longTaken  and bullPin[1] and volume[1] < volMA[1] and close > open and high > high[1]
contShort = showCont and shortTaken and bearPin[1] and volume[1] < volMA[1] and close < open and low  < low[1]

plotshape(contLong,  "Cont LONG",  shape.labelup,   location.belowbar,
     color=color.new(color.green, 30), size=size.tiny, text="+", textcolor=color.white)
plotshape(contShort, "Cont SHORT", shape.labeldown, location.abovebar,
     color=color.new(color.red, 30),   size=size.tiny, text="+", textcolor=color.white)

// =============================================================
// TP1 / TP2 — TOMA DE GANANCIAS Y TRAILING
//
//   TP1 (LONG):  precio alcanza la PRÓXIMA zona de liquidez ARRIBA del
//                entry (OB / FVG / PDH) o forma un DOBLE TECHO.
//   TP1 (SHORT): mismo concepto, espejado (OB / FVG / PDL / doble fondo).
//
//   TP2 (LONG):  tras TP1, cada nuevo máximo desplaza el trailing stop al
//                low de la vela alcista anterior; TP2 dispara cuando el
//                cierre rompe ese trailing hacia abajo.
//   TP2 (SHORT): espejo — trailing al high de la vela bajista anterior;
//                TP2 al primer cierre por encima del trailing.
// =============================================================

// Helpers — busca la zona más cercana ARRIBA / DEBAJO del precio en
// un array de boxes (usa box.get_bottom / box.get_top según dirección).
fNearestBoxAbove(arr, px) =>
    float best = na
    if array.size(arr) > 0
        for i = 0 to array.size(arr) - 1
            b   = array.get(arr, i)
            bot = box.get_bottom(b)
            if bot > px and (na(best) or bot < best)
                best := bot
    best

fNearestBoxBelow(arr, px) =>
    float best = na
    if array.size(arr) > 0
        for i = 0 to array.size(arr) - 1
            b   = array.get(arr, i)
            top = box.get_top(b)
            if top < px and (na(best) or top > best)
                best := top
    best

// Estado por dirección
var float longEntry       = na
var float longTP1Target   = na
var bool  longTP1Fired    = false
var bool  longTP2Fired    = false
var float longMaxSinceTP1 = na
var float longTrailStop   = na

var float shortEntry       = na
var float shortTP1Target   = na
var bool  shortTP1Fired    = false
var bool  shortTP2Fired    = false
var float shortMinSinceTP1 = na
var float shortTrailStop   = na

// Low de la última vela alcista cerrada / high de la última bajista cerrada
var float prevBullLow  = na
var float prevBearHigh = na
if close[1] > open[1]
    prevBullLow := low[1]
if close[1] < open[1]
    prevBearHigh := high[1]

// Reset en cada Kill Zone nueva
if newKZ
    longEntry        := na
    longTP1Target    := na
    longTP1Fired     := false
    longTP2Fired     := false
    longMaxSinceTP1  := na
    longTrailStop    := na
    shortEntry       := na
    shortTP1Target   := na
    shortTP1Fired    := false
    shortTP2Fired    := false
    shortMinSinceTP1 := na
    shortTrailStop   := na

// En la señal primaria: capturar entry y calcular objetivo TP1 más cercano
if longSignal
    longEntry        := close
    longTP1Fired     := false
    longTP2Fired     := false
    longMaxSinceTP1  := na
    longTrailStop    := na
    float bestAbove = na
    if not na(pdh) and pdh > close
        bestAbove := pdh
    nFB = fNearestBoxAbove(fvgBullArr, close)
    if not na(nFB) and (na(bestAbove) or nFB < bestAbove)
        bestAbove := nFB
    nFR = fNearestBoxAbove(fvgBearArr, close)
    if not na(nFR) and (na(bestAbove) or nFR < bestAbove)
        bestAbove := nFR
    nOB = fNearestBoxAbove(obBullArr, close)
    if not na(nOB) and (na(bestAbove) or nOB < bestAbove)
        bestAbove := nOB
    nOR = fNearestBoxAbove(obBearArr, close)
    if not na(nOR) and (na(bestAbove) or nOR < bestAbove)
        bestAbove := nOR
    longTP1Target := bestAbove

if shortSignal
    shortEntry        := close
    shortTP1Fired     := false
    shortTP2Fired     := false
    shortMinSinceTP1  := na
    shortTrailStop    := na
    float bestBelow = na
    if not na(pdl) and pdl < close
        bestBelow := pdl
    nFB2 = fNearestBoxBelow(fvgBullArr, close)
    if not na(nFB2) and (na(bestBelow) or nFB2 > bestBelow)
        bestBelow := nFB2
    nFR2 = fNearestBoxBelow(fvgBearArr, close)
    if not na(nFR2) and (na(bestBelow) or nFR2 > bestBelow)
        bestBelow := nFR2
    nOB2 = fNearestBoxBelow(obBullArr, close)
    if not na(nOB2) and (na(bestBelow) or nOB2 > bestBelow)
        bestBelow := nOB2
    nOR2 = fNearestBoxBelow(obBearArr, close)
    if not na(nOR2) and (na(bestBelow) or nOR2 > bestBelow)
        bestBelow := nOR2
    shortTP1Target := bestBelow

// Doble techo / doble fondo vía pivotes (lag = pivotBars barras)
phP = ta.pivothigh(high, pivotBars, pivotBars)
plP = ta.pivotlow(low,   pivotBars, pivotBars)

var float lastPivotHighLong = na
var float lastPivotLowShort = na

if longSignal
    lastPivotHighLong := na
if shortSignal
    lastPivotLowShort := na

dblTol = ta.atr(14) * doubleTolAtr

doubleTopLong     = false
doubleBottomShort = false

if longTaken and not longTP1Fired and useDoubleEnd
    if not na(phP)
        if not na(lastPivotHighLong) and math.abs(phP - lastPivotHighLong) <= dblTol
            doubleTopLong := true
        lastPivotHighLong := phP

if shortTaken and not shortTP1Fired and useDoubleEnd
    if not na(plP)
        if not na(lastPivotLowShort) and math.abs(plP - lastPivotLowShort) <= dblTol
            doubleBottomShort := true
        lastPivotLowShort := plP

// Disparo TP1
tp1LongFire  = longTaken  and not longTP1Fired  and (
     (not na(longTP1Target)  and high >= longTP1Target)
     or doubleTopLong)
tp1ShortFire = shortTaken and not shortTP1Fired and (
     (not na(shortTP1Target) and low  <= shortTP1Target)
     or doubleBottomShort)

if tp1LongFire
    longTP1Fired    := true
    longMaxSinceTP1 := high
if tp1ShortFire
    shortTP1Fired    := true
    shortMinSinceTP1 := low

// Trailing TP2 — LONG: nuevo máximo → trail = low de vela alcista previa
if longTP1Fired and not longTP2Fired
    if high > nz(longMaxSinceTP1, low - 1)
        longMaxSinceTP1 := high
        if not na(prevBullLow)
            longTrailStop := prevBullLow

tp2LongFire = longTP1Fired and not longTP2Fired and not na(longTrailStop) and close < longTrailStop
if tp2LongFire
    longTP2Fired := true

// Trailing TP2 — SHORT: nuevo mínimo → trail = high de vela bajista previa
if shortTP1Fired and not shortTP2Fired
    if low < nz(shortMinSinceTP1, high + 1)
        shortMinSinceTP1 := low
        if not na(prevBearHigh)
            shortTrailStop := prevBearHigh

tp2ShortFire = shortTP1Fired and not shortTP2Fired and not na(shortTrailStop) and close > shortTrailStop
if tp2ShortFire
    shortTP2Fired := true

// Marcadores en el chart
plotshape(showTP1 and tp1LongFire,
     "TP1 LONG",  shape.labeldown, location.abovebar,
     color=color.new(color.green, 0),  size=size.small, text="TP1", textcolor=color.white)
plotshape(showTP1 and tp1ShortFire,
     "TP1 SHORT", shape.labelup,   location.belowbar,
     color=color.new(color.red, 0),    size=size.small, text="TP1", textcolor=color.white)
plotshape(showTP2 and tp2LongFire,
     "TP2 LONG",  shape.labeldown, location.abovebar,
     color=color.new(color.olive, 0),  size=size.small, text="TP2", textcolor=color.white)
plotshape(showTP2 and tp2ShortFire,
     "TP2 SHORT", shape.labelup,   location.belowbar,
     color=color.new(color.purple, 0), size=size.small, text="TP2", textcolor=color.white)

// Líneas visuales: objetivo TP1 y trailing TP2
plot(showTPLines and longTaken     and not longTP1Fired  ? longTP1Target  : na,
     "Objetivo TP1 LONG",  color=color.new(color.green, 30),
     style=plot.style_linebr, linewidth=1)
plot(showTPLines and shortTaken    and not shortTP1Fired ? shortTP1Target : na,
     "Objetivo TP1 SHORT", color=color.new(color.red, 30),
     style=plot.style_linebr, linewidth=1)
plot(showTPLines and longTP1Fired  and not longTP2Fired  ? longTrailStop  : na,
     "Trailing LONG",  color=color.new(color.olive, 0),
     style=plot.style_stepline, linewidth=1)
plot(showTPLines and shortTP1Fired and not shortTP2Fired ? shortTrailStop : na,
     "Trailing SHORT", color=color.new(color.purple, 0),
     style=plot.style_stepline, linewidth=1)

// =============================================================
// BACKGROUND HIGHLIGHTING
// =============================================================
bgcolor(showKZbg and inKZ      ? color.new(color.blue,   93) : na, title="Kill Zone bg")
bgcolor(showOR   and inFirst15 ? color.new(color.yellow, 93) : na, title="OR window bg")

// =============================================================
// ALERTS
// =============================================================
alertcondition(longSignal,  title="LONG Apertura NY",
     message="LONG en {{ticker}} a {{close}} — Kill Zone NY Open 5m")
alertcondition(shortSignal, title="SHORT Apertura NY",
     message="SHORT en {{ticker}} a {{close}} — Kill Zone NY Open 5m")
alertcondition(contLong,    title="Continuación LONG",
     message="Continuación LONG en {{ticker}} a {{close}}")
alertcondition(contShort,   title="Continuación SHORT",
     message="Continuación SHORT en {{ticker}} a {{close}}")

alertcondition(tp1LongFire,  title="TP1 LONG",
     message="TP1 LONG en {{ticker}} a {{close}}")
alertcondition(tp1ShortFire, title="TP1 SHORT",
     message="TP1 SHORT en {{ticker}} a {{close}}")
alertcondition(tp2LongFire,  title="TP2 LONG (trailing)",
     message="TP2 LONG trailing en {{ticker}} a {{close}}")
alertcondition(tp2ShortFire, title="TP2 SHORT (trailing)",
     message="TP2 SHORT trailing en {{ticker}} a {{close}}")
