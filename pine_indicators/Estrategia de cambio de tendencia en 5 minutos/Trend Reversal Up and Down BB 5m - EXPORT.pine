//@version=6
// =============================================================
// STRATEGY (EXPORT): Trend Reversal Up & Down BB 5m
// Version strategy() del indicador: MISMA logica de senales, pero cada senal abre un trade
// simulado (CALL=long, PUT=short) que se cierra al fin de la sesion -> para exportar la
// "List of Trades" del Strategy Tester a CSV (1 fila por senal, con fecha/hora exactas).
// OJO: el P&L de aqui es del SUBYACENTE, no de las opciones (el backtest real lo hace la app).
//
// 🎯 ESTRATEGIA: Cambio de tendencia (CALL + PUT) en 5min
//                (Para operar apenas abra el mercado)
//
// ADAPTACION del "TR-UD-15m - EXPORT" a velas de 5m. Logica IDENTICA;
// defaults basados en CANTIDAD DE VELAS escalados x3 (1 vela de 15m =
// 3 velas de 5m) para conservar las mismas ventanas de TIEMPO:
//   Pivot 3->9 · Lookback 40->120 · Forward 20->60 · R1 20->60 · Cooldown 8->24
//   Bollinger (20, 2.0) se mantiene (convencion relativa al TF; 60 = equivalente exacto).
//
// Combina las dos direcciones en un solo indicador:
//
//   UP (CALL): cambio bajista/lateral -> alcista en apertura
//     - Linea BAJISTA (resistance, pivots highs descendentes, roja)
//     - Senal ▲ verde "U" cuando gap UP rompe linea + midpoint
//
//   DOWN (PUT): cambio alcista/lateral -> bajista en apertura
//     - Linea ALCISTA (support, pivots lows ascendentes, lima)
//     - Senal ▼ rojo "D" cuando gap DOWN rompe linea + midpoint
//
// Las 4 reglas se aplican simetricamente:
//   R1: Tendencia previa apropiada (no opuesta a la senal)
//   R2: Trendline activa en su direccion
//   R3: Gap en apertura rompe midpoint + trendline en su direccion
//   R4: Volatilidad en la apertura (compartida)
// =============================================================

strategy("Trend Reversal Up & Down BB 5m - EXPORT", shorttitle="TR-UD-5m-EXP",
     overlay=true,
     max_lines_count=500,
     max_labels_count=500,
     process_orders_on_close=true,
     default_qty_type=strategy.fixed, default_qty_value=1,
     initial_capital=10000,
     commission_type=strategy.commission.percent, commission_value=0)

// =============================================================
// IDIOMA / LANGUAGE
// =============================================================
grpLang = "Idioma / Language"
lang    = input.string("Espanol", "Idioma / Language", options=["Espanol", "English"], group=grpLang,
     tooltip="ES: Selecciona idioma para textos del chart (tooltips, tabla, alertas). Los nombres de inputs siempre se muestran en espanol por limitacion de Pine Script (no soporta texto dinamico en inputs).\n\nEN: Select language for chart text (tooltips, table, alerts). Input names always shown in Spanish due to Pine Script limitation (no dynamic input text supported).")

isES = lang == "Espanol"

// Traducciones / Translations (solo afectan textos del chart)
t_strategy_up = isES ? "      CAMBIO DE TENDENCIA AL ALZA\nEN 5 MINUTOS CON BOLLINGER BANDS" : "      BULLISH TREND REVERSAL\nIN 5 MINUTES WITH BOLLINGER BANDS"
t_strategy_dn = isES ? "    CAMBIO DE TENDENCIA A LA BAJA\nEN 5 MINUTOS CON BOLLINGER BANDS" : "      BEARISH TREND REVERSAL\nIN 5 MINUTES WITH BOLLINGER BANDS"
// Nota: los mensajes de alertcondition deben ser const strings (limitacion de Pine).
// Los textos t_alert_* se eliminaron - el mensaje queda fijo bilingue en alertcondition.
t_off        = "OFF"
t_yes        = isES ? "SI" : "YES"
t_no         = isES ? "no" : "no"
t_open       = isES ? "APER" : "OPEN"
t_intra      = isES ? "intra" : "intra"
t_rule1      = isES ? "1. Tendencia Previa B5m"         : "1. Previous trend"
t_rule2      = isES ? "2. Ruptura Línea de Tendencia"   : "2. Trendline break"
t_rule3      = isES ? "3. Ruptura Pto Medio día-previo" : "3. Prev-day midpoint break"
t_rule4      = isES ? "4. Apertura Dentro de Bollinger" : "4. Open inside Bollinger"
t_signals    = isES ? "Senales" : "Signals"
t_opening    = isES ? "Vela apertura" : "Opening bar"

// =============================================================
// INPUTS
// =============================================================

// Direccion (toggles para activar UP/DOWN independientemente)
grpDir     = "Direccion (CALL / PUT)"
enableUp   = input.bool(true, "Activar senales UP (CALL)",   group=grpDir,
     tooltip="Detecta gap UP en apertura que rompe linea bajista + midpoint. Genera ▲ verde 'CALL'.")
enableDown = input.bool(true, "Activar senales DOWN (PUT)", group=grpDir,
     tooltip="Detecta gap DOWN en apertura que rompe linea alcista + midpoint. Genera ▼ rojo 'PUT'.")

// Bollinger Bands
grpBB  = "Bollinger Bands"
bbLen  = input.int(20,  "Periodo BB", group=grpBB, minval=2,
     tooltip="Se mantiene 20 (convencion BB relativa al timeframe). Para el equivalente EXACTO en tiempo del BB(20) de 15m, usar 60.")
bbMult = input.float(2.0, "Desviacion BB", group=grpBB, minval=0.1, step=0.1)

// Linea de tendencia auto-detectada (compartido)
grpLine        = "Linea de tendencia (auto-detectada)"
pivotLen       = input.int(9, "Pivot strength (left/right)", group=grpLine, minval=1, maxval=30,
     tooltip="Velas a cada lado para confirmar pivot. Default 9 para 5m (= 45 min por lado, equivalente al 3 de 15m). Bajar a 3-5 da pivots mas granulares pero mas ruido.")
trendlineLookback = input.int(120, "Lookback de pivots para la trendline (5m)", group=grpLine, minval=6, maxval=600,
     tooltip="Ventana de velas hacia atras de la que se toman los pivots para AJUSTAR la trendline multi-punto (best-fit, tocando la mayor cantidad de puntos). Default 120 = ~1.5 dias en 5m (equivale al 40 de 15m): cubre la baja/subida previa hasta la apertura.")
maxBarsForward = input.int(60, "Extension forward (bars)", group=grpLine, minval=5, maxval=300,
     tooltip="Cuantas velas adelante se extiende la linea desde el ultimo pivot. Default 60 = 5 horas en 5m (equivale al 20 de 15m).")
maxLinesKeep   = input.int(30, "Max lineas dibujadas (por direccion)", group=grpLine, minval=5, maxval=200)

// Rango del dia anterior
grpPrev        = "Rango del dia anterior"
showPrevLevels = input.bool(true, "Mostrar high/low/midpoint del dia anterior", group=grpPrev,
     tooltip="Dibuja lineas horizontales en el high, low y midpoint (50%) del dia anterior. El midpoint es la referencia clave de la Regla 3.")
midpointPct    = input.float(0.5, "Midpoint (% del rango)", group=grpPrev, minval=0.0, maxval=1.0, step=0.05,
     tooltip="Posicion del midpoint dentro del rango del dia anterior. 0.5 = 50% (default).")

// Regla 1 - Tendencia previa
grpR1            = "Regla 1 - Tendencia previa"
lateralLookback  = input.int(60, "Bars hacia atras (5m)", group=grpR1, minval=5, maxval=300,
     tooltip="Cuantos bars de 5m hacia atras para medir la pendiente del basis. Default 60 = 5 horas atras (equivale al 20 de 15m).")
lateralThreshold = input.float(0.5, "Maxima pendiente opuesta permitida (%)", group=grpR1, minval=0.0, step=0.1,
     tooltip="Para UP: basis no puede subir mas de X% (debe ser bajista o lateral). Para DOWN: basis no puede caer mas de X% (debe ser alcista o lateral). Default 0.5% (misma ventana de tiempo que en 15m, el umbral no cambia).")

// Regla 4 - Volatilidad en la apertura (compartida)
grpR4         = "Regla 4 - Volatilidad apertura"
useVolFilter  = input.bool(true, "Activar filtro de volatilidad", group=grpR4)
volMultATR    = input.float(1.0, "Rango minimo / ATR(14)", group=grpR4, minval=0.1, step=0.1,
     tooltip="El rango (high - low) de la vela de apertura debe ser >= X * ATR(14). Default 1.0.")

// Modo intradia (cruces en toda la sesion, no solo la apertura)
grpIntra       = "Modo intradia"
intraday       = input.bool(true,  "Detectar en TODA la sesion (cruces, no solo apertura)", group=grpIntra,
     tooltip="ON (default): dispara cuando el CIERRE CRUZA la trendline en cualquier vela de la sesion regular. OFF: solo la vela de apertura (gap del open).")
cooldownBars   = input.int(24, "Cooldown tras senal (velas)", group=grpIntra, minval=0, maxval=600,
     tooltip="Velas de espera tras una senal intradia (evita clusters de senales seguidas). Default 24 = 2 horas en 5m (equivale al 8 de 15m).")
requireInBands = input.bool(true, "Intradia: exigir cierre DENTRO de las Bandas", group=grpIntra,
     tooltip="Filtro de sobre-extension: descarta cruces con el precio fuera de las bandas de Bollinger.")

// Activacion de reglas (debug)
grpToggles    = "Activacion de reglas (para pruebas)"
useRule1      = input.bool(true, "Activar Regla 1 (tendencia previa)", group=grpToggles)
useRule2      = input.bool(true, "Activar Regla 2 (trendline)", group=grpToggles)
useRule3      = input.bool(true, "Activar Regla 3 (rompe punto medio BB)", group=grpToggles)
useRule4      = input.bool(true, "Activar Regla 4 (apertura dentro de bandas)", group=grpToggles)
showPrePostSignals = input.bool(false, "Mostrar senales en premarket/postmarket", group=grpToggles,
     tooltip="OFF (default): la senal solo dispara en la primera vela de la sesion REGULAR (9:30 AM ET para US stocks). ON: tambien dispara en la apertura del premarket (~4:00 AM ET) o cualquier otra apertura de sesion.")

// Visualizacion
grpViz          = "Visualizacion"
showLines       = input.bool(true,  "Mostrar lineas de tendencia",       group=grpViz)
onlySignalLines = input.bool(true,  "Solo lineas que dispararon senal",  group=grpViz,
     tooltip="ON: solo se conservan lineas que dispararon senal + la actual de cada direccion. OFF: todas las lineas detectadas.")
showPivots      = input.bool(false, "Mostrar marcadores de pivots",      group=grpViz)
showTable       = input.bool(false, "Mostrar tabla de reglas",           group=grpViz)
showBBLabels    = input.bool(false, "Mostrar etiquetas BB en la escala", group=grpViz)
showTooltip     = input.bool(false, "Tooltips por vela (ultimas 500)",   group=grpViz)

// =============================================================
// BOLLINGER BANDS
// =============================================================
basis = ta.sma(close, bbLen)
dev   = bbMult * ta.stdev(close, bbLen)
upper = basis + dev
lower = basis - dev

bbDisplay = showBBLabels ? display.all : display.pane + display.status_line + display.data_window
plot(basis, "BB basis", color=color.orange, linewidth=2, display=bbDisplay)
p1 = plot(upper, "BB upper", color=color.new(color.gray, 50), display=bbDisplay)
p2 = plot(lower, "BB lower", color=color.new(color.gray, 50), display=bbDisplay)
fill(p1, p2, color=color.new(color.gray, 92))

// =============================================================
// RANGO DEL DIA ANTERIOR
// =============================================================
[prevHigh, prevLow] = request.security(syminfo.tickerid, "D",
     [high[1], low[1]], lookahead=barmerge.lookahead_off)

prevMidpoint = prevLow + (prevHigh - prevLow) * midpointPct

plot(showPrevLevels ? prevHigh     : na, "Prev Day High", color=color.new(color.gray,  20), linewidth=1, style=plot.style_circles)
plot(showPrevLevels ? prevLow      : na, "Prev Day Low",  color=color.new(color.gray,  20), linewidth=1, style=plot.style_circles)
plot(showPrevLevels ? prevMidpoint : na, "Midpoint",      color=color.new(color.yellow, 0), linewidth=1, style=plot.style_circles)

// =============================================================
// DETECCION DE PRIMERA VELA DE APERTURA
// =============================================================
isOpeningBar = showPrePostSignals ? (ta.change(time("D")) != 0) : session.isfirstbar_regular

// =============================================================
// REGLA 1 - Tendencia previa (por direccion)
// =============================================================
basisChangePct = (basis - basis[lateralLookback]) / basis[lateralLookback] * 100
ruleUp1 = basisChangePct <= lateralThreshold
ruleDn1 = basisChangePct >= -lateralThreshold

// =============================================================
// REGLA 2 (UP) - Trendline BAJISTA multi-punto (resistencia, máximos decrecientes)
// =============================================================
// Doc: trendline diagonal por la parte alta tocando la mayor cantidad de máximos
// decrecientes (lower highs). Se juntan los pivots high de la ventana y se traza la
// RESISTENCIA como borde superior: ancla en el pivot MÁS ALTO y se elige la pendiente
// que deja a TODOS los demás pivots por debajo (toca el máximo de puntos posible).
ph = ta.pivothigh(high, pivotLen, pivotLen)

var array<float> phP = array.new<float>()
var array<int>   phB = array.new<int>()

if not na(ph)
    array.push(phP, ph)
    array.push(phB, bar_index - pivotLen)

while array.size(phB) > 0 and array.get(phB, 0) < bar_index - trendlineLookback
    array.shift(phP)
    array.shift(phB)

float upLineStartPrice = na
int   upLineStartBar   = na
float upLineSlope      = na
int   upLineEndBar     = na

int _nU = array.size(phP)
if _nU >= 2
    int   _aiU   = 0
    float _amaxU = array.get(phP, 0)
    for _i = 1 to _nU - 1
        if array.get(phP, _i) > _amaxU
            _amaxU := array.get(phP, _i)
            _aiU   := _i
    int   _aBarU   = array.get(phB, _aiU)
    float _aPriceU = array.get(phP, _aiU)
    float _bestU   = na
    for _k = 0 to _nU - 1
        int _dbU = array.get(phB, _k) - _aBarU
        if _dbU > 0
            float _rU = (array.get(phP, _k) - _aPriceU) / _dbU
            if na(_bestU) or _rU > _bestU
                _bestU := _rU
    if not na(_bestU) and _bestU < 0
        upLineStartPrice := _aPriceU
        upLineStartBar   := _aBarU
        upLineSlope      := _bestU
        upLineEndBar     := array.get(phB, _nU - 1) + maxBarsForward

// Línea VIVA de resistencia (punteada), se actualiza cada barra
var line upLine = na
bool _drawUpLive = showLines and enableUp and not onlySignalLines and not na(upLineStartPrice) and bar_index <= upLineEndBar
if _drawUpLive
    float _uy2 = upLineStartPrice + upLineSlope * (upLineEndBar - upLineStartBar)
    if na(upLine)
        upLine := line.new(upLineStartBar, upLineStartPrice, upLineEndBar, _uy2, color=color.new(color.red, 0), width=2, style=line.style_dashed)
    else
        line.set_xy1(upLine, upLineStartBar, upLineStartPrice)
        line.set_xy2(upLine, upLineEndBar, _uy2)
else
    if not na(upLine)
        line.delete(upLine)
        upLine := na

// =============================================================
// REGLA 2 (DOWN) - Trendline ALCISTA multi-punto (soporte, mínimos crecientes)
// =============================================================
// Doc: línea diagonal por debajo del precio conectando la mayor cantidad de mínimos
// crecientes (higher lows). SOPORTE como borde inferior: ancla en el pivot MÁS BAJO y
// se elige la pendiente que deja a TODOS los demás pivots por encima.
pl = ta.pivotlow(low, pivotLen, pivotLen)

var array<float> plP = array.new<float>()
var array<int>   plB = array.new<int>()

if not na(pl)
    array.push(plP, pl)
    array.push(plB, bar_index - pivotLen)

while array.size(plB) > 0 and array.get(plB, 0) < bar_index - trendlineLookback
    array.shift(plP)
    array.shift(plB)

float dnLineStartPrice = na
int   dnLineStartBar   = na
float dnLineSlope      = na
int   dnLineEndBar     = na

int _nD = array.size(plP)
if _nD >= 2
    int   _aiD   = 0
    float _aminD = array.get(plP, 0)
    for _i = 1 to _nD - 1
        if array.get(plP, _i) < _aminD
            _aminD := array.get(plP, _i)
            _aiD   := _i
    int   _aBarD   = array.get(plB, _aiD)
    float _aPriceD = array.get(plP, _aiD)
    float _bestD   = na
    for _k = 0 to _nD - 1
        int _dbD = array.get(plB, _k) - _aBarD
        if _dbD > 0
            float _rD = (array.get(plP, _k) - _aPriceD) / _dbD
            if na(_bestD) or _rD < _bestD
                _bestD := _rD
    if not na(_bestD) and _bestD > 0
        dnLineStartPrice := _aPriceD
        dnLineStartBar   := _aBarD
        dnLineSlope      := _bestD
        dnLineEndBar     := array.get(plB, _nD - 1) + maxBarsForward

// Línea VIVA de soporte (punteada), se actualiza cada barra
var line dnLine = na
bool _drawDnLive = showLines and enableDown and not onlySignalLines and not na(dnLineStartPrice) and bar_index <= dnLineEndBar
if _drawDnLive
    float _dy2 = dnLineStartPrice + dnLineSlope * (dnLineEndBar - dnLineStartBar)
    if na(dnLine)
        dnLine := line.new(dnLineStartBar, dnLineStartPrice, dnLineEndBar, _dy2, color=color.new(color.lime, 0), width=2, style=line.style_dashed)
    else
        line.set_xy1(dnLine, dnLineStartBar, dnLineStartPrice)
        line.set_xy2(dnLine, dnLineEndBar, _dy2)
else
    if not na(dnLine)
        line.delete(dnLine)
        dnLine := na

plotshape(showPivots and not na(ph), title="Pivot High",
     style=shape.circle, location=location.abovebar,
     color=color.new(color.yellow, 0), size=size.tiny, offset=-pivotLen)
plotshape(showPivots and not na(pl), title="Pivot Low",
     style=shape.circle, location=location.belowbar,
     color=color.new(color.aqua, 0), size=size.tiny, offset=-pivotLen)

upTrendlineActive = not na(upLineStartPrice) and not na(upLineEndBar) and bar_index <= upLineEndBar
upTrendlineNow    = upTrendlineActive ? upLineStartPrice + upLineSlope * (bar_index - upLineStartBar) : na

dnTrendlineActive = not na(dnLineStartPrice) and not na(dnLineEndBar) and bar_index <= dnLineEndBar
dnTrendlineNow    = dnTrendlineActive ? dnLineStartPrice + dnLineSlope * (bar_index - dnLineStartBar) : na

// =============================================================
// REGLA 2 - Ruptura de la Línea de Tendencia (el precio ROMPE la trendline)
//   Apertura (intraday OFF): el gap del OPEN cruza la trendline.
//   Intradia (intraday ON):  el CIERRE cruza la trendline en cualquier vela.
// =============================================================
upCross = not na(upTrendlineNow) and not na(upTrendlineNow[1]) and close > upTrendlineNow and close[1] <= upTrendlineNow[1]
dnCross = not na(dnTrendlineNow) and not na(dnTrendlineNow[1]) and close < dnTrendlineNow and close[1] >= dnTrendlineNow[1]
ruleUp2 = intraday ? upCross : (upTrendlineActive and not na(upTrendlineNow) and open > upTrendlineNow)
ruleDn2 = intraday ? dnCross : (dnTrendlineActive and not na(dnTrendlineNow) and open < dnTrendlineNow)

// =============================================================
// REGLA 3 - Ruptura del Punto Medio del DÍA PREVIO (da mejor rendimiento que el basis)
// =============================================================
ruleUp3 = intraday ? (not na(prevMidpoint) and close > prevMidpoint) : (isOpeningBar and not na(prevMidpoint) and open > prevMidpoint)
ruleDn3 = intraday ? (not na(prevMidpoint) and close < prevMidpoint) : (isOpeningBar and not na(prevMidpoint) and open < prevMidpoint)

// =============================================================
// REGLA 4 - Apertura DENTRO de las Bandas de Bollinger (compartida)
// =============================================================
priceR4 = intraday ? close : open
rule4   = (not na(upper)) and (not na(lower)) and priceR4 >= lower and priceR4 <= upper

// =============================================================
// SENAL COMPLETA por direccion
// =============================================================
effUp1 = (not useRule1) or ruleUp1
effUp2 = (not useRule2) or ruleUp2
effUp3 = (not useRule3) or ruleUp3
effUp4 = (not useRule4) or rule4

effDn1 = (not useRule1) or ruleDn1
effDn2 = (not useRule2) or ruleDn2
effDn3 = (not useRule3) or ruleDn3
effDn4 = (not useRule4) or rule4

// Cooldown del modo intradia (evita clusters de senales seguidas).
var int lastSigBarUp = na
var int lastSigBarDn = na
gateCdUp = (not intraday) or na(lastSigBarUp) or (bar_index - lastSigBarUp >= cooldownBars)
gateCdDn = (not intraday) or na(lastSigBarDn) or (bar_index - lastSigBarDn >= cooldownBars)

fullSignalUp = enableUp   and effUp1 and effUp2 and effUp3 and effUp4 and gateCdUp
fullSignalDn = enableDown and effDn1 and effDn2 and effDn3 and effDn4 and gateCdDn

breakoutUp = fullSignalUp and not fullSignalUp[1]
breakoutDn = fullSignalDn and not fullSignalDn[1]

if breakoutUp
    lastSigBarUp := bar_index
if breakoutDn
    lastSigBarDn := bar_index

// Snapshot SÓLIDO de la trendline que disparó la señal (queda fija en el chart)
var array<line> upFrozen = array.new<line>()
var array<line> dnFrozen = array.new<line>()

if breakoutUp and showLines and enableUp and not na(upLineStartPrice)
    line _flU = line.new(upLineStartBar, upLineStartPrice, bar_index, upTrendlineNow, color=color.new(color.red, 0), width=2, style=line.style_solid)
    array.push(upFrozen, _flU)
    if array.size(upFrozen) > maxLinesKeep
        line.delete(array.shift(upFrozen))

if breakoutDn and showLines and enableDown and not na(dnLineStartPrice)
    line _flD = line.new(dnLineStartBar, dnLineStartPrice, bar_index, dnTrendlineNow, color=color.new(color.lime, 0), width=2, style=line.style_solid)
    array.push(dnFrozen, _flD)
    if array.size(dnFrozen) > maxLinesKeep
        line.delete(array.shift(dnFrozen))

// =============================================================
// STRATEGY: 1 operacion por senal -> para exportar "List of Trades" a CSV
// =============================================================
// CALL = long, PUT = short (solo para que cada senal sea un trade con su timestamp de entrada;
// el P&L de aqui NO es el de opciones). process_orders_on_close=true -> la entrada cae en la
// vela de la senal. Se cierra la vela SIGUIENTE a la entrada (NO se mantiene al EOD) para quedar
// flat y capturar TODAS las senales: antes, al mantener hasta EOD con pyramiding=0, una 2a senal
// de la MISMA direccion el mismo dia quedaba bloqueada (la estrategia ya estaba en posicion).
if breakoutUp
    strategy.entry("CALL", strategy.long)
if breakoutDn
    strategy.entry("PUT", strategy.short)
// Cerrar 1 vela despues de cualquier entrada (en barras sin senal nueva) -> cada senal = 1 trade.
if strategy.position_size != 0 and not breakoutUp and not breakoutDn
    strategy.close_all(comment="signal")

// =============================================================
// CONTADORES por direccion
// =============================================================
var int countUp1   = 0
var int countUp2   = 0
var int countUp3   = 0
var int countUp4   = 0
var int countUpSig = 0

var int countDn1   = 0
var int countDn2   = 0
var int countDn3   = 0
var int countDn4   = 0
var int countDnSig = 0

if ruleUp1 and not ruleUp1[1]
    countUp1 += 1
if ruleUp2 and not ruleUp2[1]
    countUp2 += 1
if ruleUp3 and not ruleUp3[1]
    countUp3 += 1
if rule4 and not rule4[1]
    countUp4 += 1
if breakoutUp
    countUpSig += 1

if ruleDn1 and not ruleDn1[1]
    countDn1 += 1
if ruleDn2 and not ruleDn2[1]
    countDn2 += 1
if ruleDn3 and not ruleDn3[1]
    countDn3 += 1
if rule4 and not rule4[1]
    countDn4 += 1
if breakoutDn
    countDnSig += 1

// =============================================================
// PLOTSHAPES y ALERTAS
// =============================================================
plotshape(breakoutUp, title="UP Signal",
     style=shape.triangleup, location=location.belowbar,
     color=color.new(color.lime, 0), size=size.small)

plotshape(breakoutDn, title="DOWN Signal",
     style=shape.triangledown, location=location.abovebar,
     color=color.new(color.red, 0), size=size.small)

// Texto "U"/"D" via label.new para soportar tooltip nativo en hover.
// El tooltip se traduce segun el idioma seleccionado.
// UP: tooltip "CAMBIO DE TENDENCIA AL ALTA..." / "BULLISH..."
// DN: tooltip "CAMBIO DE TENDENCIA A LA BAJA..." / "BEARISH..."
if breakoutUp
    label.new(bar_index, low, "UP",
         yloc=yloc.belowbar,
         style=label.style_none,
         textcolor=color.new(color.lime, 0),
         size=size.small,
         tooltip=t_strategy_up)
if breakoutDn
    label.new(bar_index, high, "DW",
         yloc=yloc.abovebar,
         style=label.style_none,
         textcolor=color.new(color.red, 0),
         size=size.small,
         tooltip=t_strategy_dn)

// NOTA: alertcondition requiere const string en message (limitacion de Pine).
// Por eso el mensaje queda fijo en bilingue, no depende del dropdown.
alertcondition(breakoutUp, title="CALL opening signal", message="TR-UD-5m CALL apertura / opening {{ticker}} @ {{close}}")
alertcondition(breakoutDn, title="PUT opening signal",  message="TR-UD-5m PUT apertura / opening {{ticker}} @ {{close}}")

// =============================================================
// EXPORT A CSV (para backtesting fuera de TradingView)
// =============================================================
// plotshape/alertcondition NO se exportan con "Export chart data" (solo plot()).
// Estas 2 series ponen 1 en la vela donde dispara la senal -> en el CSV exportado salen
// como columnas "Signal CALL" / "Signal PUT". display.data_window = no ensucian el chart.
plot(breakoutUp ? 1 : na, "Signal CALL", display=display.data_window)
plot(breakoutDn ? 1 : na, "Signal PUT",  display=display.data_window)

// =============================================================
// TABLA DE REGLAS (4 columnas: Concepto | UP | DOWN | Counts)
// =============================================================
f_check(bool b) => b ? "[X]" : "[ ]"
f_bg(bool b)    => b ? color.new(color.green, 60) : color.new(color.gray, 70)

var table tbl = na
if showTable and barstate.islast
    table.delete(tbl)
    tbl := table.new(position.top_right, 4, 8,
         bgcolor=color.new(color.black, 20),
         border_color=color.new(color.gray, 50), border_width=1)

    table.cell(tbl, 0, 0, "TR-UD-5m",
         text_color=color.white, bgcolor=color.new(color.blue, 30), text_halign=text.align_left)
    table.cell(tbl, 1, 0, "UP",
         text_color=color.white, bgcolor=color.new(color.green, 50))
    table.cell(tbl, 2, 0, "DOWN",
         text_color=color.white, bgcolor=color.new(color.red, 50))
    table.cell(tbl, 3, 0, "U/D",
         text_color=color.white, bgcolor=color.new(color.blue, 30))

    table.cell(tbl, 0, 1, syminfo.ticker,
         text_color=color.gray, bgcolor=color.new(color.black, 50), text_halign=text.align_left)
    table.cell(tbl, 1, 1, enableUp ? (isOpeningBar ? t_open : t_intra) : t_off,
         text_color=color.gray, bgcolor=color.new(color.black, 50))
    table.cell(tbl, 2, 1, enableDown ? (isOpeningBar ? t_open : t_intra) : t_off,
         text_color=color.gray, bgcolor=color.new(color.black, 50))
    table.cell(tbl, 3, 1, "",
         text_color=color.gray, bgcolor=color.new(color.black, 50))

    table.cell(tbl, 0, 2, t_rule1,
         text_color=color.white, text_halign=text.align_left)
    table.cell(tbl, 1, 2, f_check(ruleUp1), text_color=color.white, bgcolor=f_bg(ruleUp1))
    table.cell(tbl, 2, 2, f_check(ruleDn1), text_color=color.white, bgcolor=f_bg(ruleDn1))
    table.cell(tbl, 3, 2, str.tostring(countUp1) + "/" + str.tostring(countDn1),
         text_color=color.white)

    table.cell(tbl, 0, 3, t_rule2,
         text_color=color.white, text_halign=text.align_left)
    table.cell(tbl, 1, 3, f_check(ruleUp2), text_color=color.white, bgcolor=f_bg(ruleUp2))
    table.cell(tbl, 2, 3, f_check(ruleDn2), text_color=color.white, bgcolor=f_bg(ruleDn2))
    table.cell(tbl, 3, 3, str.tostring(countUp2) + "/" + str.tostring(countDn2),
         text_color=color.white)

    table.cell(tbl, 0, 4, t_rule3,
         text_color=color.white, text_halign=text.align_left)
    table.cell(tbl, 1, 4, f_check(ruleUp3), text_color=color.white, bgcolor=f_bg(ruleUp3))
    table.cell(tbl, 2, 4, f_check(ruleDn3), text_color=color.white, bgcolor=f_bg(ruleDn3))
    table.cell(tbl, 3, 4, str.tostring(countUp3) + "/" + str.tostring(countDn3),
         text_color=color.white)

    table.cell(tbl, 0, 5, t_rule4,
         text_color=color.white, text_halign=text.align_left)
    table.cell(tbl, 1, 5, f_check(rule4), text_color=color.white, bgcolor=f_bg(rule4))
    table.cell(tbl, 2, 5, f_check(rule4), text_color=color.white, bgcolor=f_bg(rule4))
    table.cell(tbl, 3, 5, str.tostring(countUp4),
         text_color=color.white)

    table.cell(tbl, 0, 6, t_signals,
         text_color=color.white, bgcolor=color.new(color.blue, 50), text_halign=text.align_left)
    table.cell(tbl, 1, 6, str.tostring(countUpSig),
         text_color=color.white, bgcolor=color.new(color.green, 30))
    table.cell(tbl, 2, 6, str.tostring(countDnSig),
         text_color=color.white, bgcolor=color.new(color.red, 30))
    table.cell(tbl, 3, 6, str.tostring(countUpSig + countDnSig),
         text_color=color.white, bgcolor=color.new(color.blue, 30))

    table.cell(tbl, 0, 7, t_opening,
         text_color=color.gray, bgcolor=color.new(color.black, 50), text_halign=text.align_left)
    table.cell(tbl, 1, 7, isOpeningBar ? t_yes : t_no,
         text_color=color.gray, bgcolor=color.new(color.black, 50))
    table.cell(tbl, 2, 7, isOpeningBar ? t_yes : t_no,
         text_color=color.gray, bgcolor=color.new(color.black, 50))
    table.cell(tbl, 3, 7, "",
         text_color=color.gray, bgcolor=color.new(color.black, 50))

// =============================================================
// TOOLTIP POR VELA
// =============================================================
if showTooltip
    midStr   = na(prevMidpoint)    ? "n/a" : str.tostring(prevMidpoint,    "#.##")
    upStr    = na(upTrendlineNow)  ? "n/a" : str.tostring(upTrendlineNow,  "#.##")
    dnStr    = na(dnTrendlineNow)  ? "n/a" : str.tostring(dnTrendlineNow,  "#.##")
    openStr  = isOpeningBar ? t_yes : t_no
    upBlock  = "UP: line=" + upStr + " R1=" + f_check(ruleUp1) + " R2=" + f_check(ruleUp2) + " R3=" + f_check(ruleUp3) + " SIG=" + f_check(fullSignalUp)
    dnBlock  = "DN: line=" + dnStr + " R1=" + f_check(ruleDn1) + " R2=" + f_check(ruleDn2) + " R3=" + f_check(ruleDn3) + " SIG=" + f_check(fullSignalDn)
    txt      = str.format_time(time, "yyyy-MM-dd HH:mm") + " open=" + str.tostring(open, "#.##") + " mid=" + midStr + " opening=" + openStr + " R4=" + f_check(rule4) + "\n" + upBlock + "\n" + dnBlock
    label.new(bar_index, high, "", tooltip=txt, yloc=yloc.abovebar,
         color=color.new(color.gray, 70), style=label.style_circle, size=size.tiny,
         textcolor=color.new(color.white, 100))
